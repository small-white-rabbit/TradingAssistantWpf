    <!-- ============ 矢量图标操作按钮（置顶/编辑/删除） ============
         图标画在 ControlTemplate 内（每个按钮实例化各自模板）。不可用 Style Setter 设 Content：
         Setter.Value 里的 UIElement 是共享单例，多按钮同引会因"已有父元素"渲染失败（按钮消失）。 -->
    <Style x:Key="PinIconButton" TargetType="Button" BasedOn="{StaticResource IconIconButton}">
        <Setter Property="ToolTip" Value="置顶"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 图钉：头 + 针脚，仿 Material push_pin -->
                            <Path Data="M9.5,2.5 L13.5,6.5 L11.3,7.4 L10.9,9.6 L8.4,7.1 L4.9,10.6 L3.4,9.1 L6.9,5.6 L4.4,3.1 Z"
                                  Fill="{TemplateBinding Foreground}"/>
                            <Path Data="M8.2,11.7 L11.3,14.8"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EditIconButton" TargetType="Button" BasedOn="{StaticResource IconIconButton}">
        <Setter Property="ToolTip" Value="编辑"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 铅笔：笔杆 + 笔尖，仿 Material edit -->
                            <Path Data="M2.5,13.5 L3.3,10.7 L11,3 L13,5 L5.3,12.7 Z"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent"/>
                            <Path Data="M11,3 L13,5"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DeleteIconButton" TargetType="Button" BasedOn="{StaticResource IconIconButton}">
        <Setter Property="ToolTip" Value="删除"/>
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 垃圾桶：桶身 + 桶盖 + 两道竖线，仿 Material delete_outline -->
                            <Path Data="M4,5.2 L12,5.2 L11.2,13.3 Q11.2,13.9 10.6,13.9 L5.4,13.9 Q4.8,13.9 4.8,13.3 Z"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"/>
                            <Path Data="M2.8,5.2 L13.2,5.2"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M6.4,5.2 L6.4,3.4 Q6.4,2.6 7.2,2.6 L8.8,2.6 Q9.6,2.6 9.6,3.4 L9.6,5.2"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.3" StrokeLineJoin="Round" Fill="Transparent"/>
                            <Path Data="M6.5,7.5 L6.5,11.5 M9.5,7.5 L9.5,11.5"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

