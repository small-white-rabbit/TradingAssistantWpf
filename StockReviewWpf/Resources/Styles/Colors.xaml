<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 主题色（Win11 Fluent accent #005FB8 系） ============ -->
    <Color x:Key="PrimaryColor">#005FB8</Color>
    <Color x:Key="PrimaryHoverColor">#1E6EC5</Color>
    <Color x:Key="PrimaryActiveColor">#005293</Color>
    <Color x:Key="PrimaryDisabledColor">#A9C7E4</Color>
    <Color x:Key="PrimaryLightColor">#E8F1FA</Color>
    <Color x:Key="PrimaryLighterColor">#F2F7FC</Color>

    <!-- 语义色（Fluent light：更深的可读文本级色值） -->
    <Color x:Key="SuccessColor">#0F7B0F</Color>
    <Color x:Key="SuccessLightColor">#EAF4EA</Color>
    <Color x:Key="WarningColor">#9D5D00</Color>
    <Color x:Key="WarningLightColor">#FBF3E3</Color>
    <Color x:Key="DangerColor">#C42B1C</Color>
    <Color x:Key="DangerHoverColor">#D13438</Color>
    <Color x:Key="DangerLightColor">#FBEDEB</Color>
    <Color x:Key="InfoColor">#6B7178</Color>
    <Color x:Key="InfoLightColor">#F1F2F4</Color>

    <!-- ============ A 股红涨绿跌语义色（Fluent 化深色，保持红涨绿跌） ============ -->
    <!-- 涨/盈利 = 红 -->
    <Color x:Key="UpColor">#C42B1C</Color>
    <Color x:Key="UpLightColor">#FBEDEB</Color>
    <!-- 跌/亏损 = 绿 -->
    <Color x:Key="DownColor">#0F7B0F</Color>
    <Color x:Key="DownLightColor">#EAF4EA</Color>
    <!-- 平 -->
    <Color x:Key="FlatColor">#6B7178</Color>

    <!-- ============ 背景色（冷灰 Mica 观感） ============ -->
    <Color x:Key="BgColor">#F3F4F6</Color>
    <Color x:Key="BgPageColor">#FFFFFF</Color>
    <Color x:Key="BgGradientEnd">#EFF1F3</Color>
    <Color x:Key="BgOverlayColor">#00000055</Color>
    <Color x:Key="BgHoverColor">#EFF1F3</Color>
    <Color x:Key="BgSelectedColor">#E8F1FA</Color>

    <!-- ============ 文字色（近黑冷灰阶） ============ -->
    <Color x:Key="TextPrimaryColor">#1B1E22</Color>
    <Color x:Key="TextRegularColor">#40444A</Color>
    <Color x:Key="TextSecondaryColor">#6B7178</Color>
    <Color x:Key="TextPlaceholderColor">#9DA3AB</Color>
    <Color x:Key="TextDisabledColor">#9DA3AB</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- ============ 边框色（Fluent 冷灰描边阶） ============ -->
    <Color x:Key="BorderColorBase">#D4D8DD</Color>
    <Color x:Key="BorderColorLight">#E3E6EA</Color>
    <Color x:Key="BorderColorLighter">#EBEDF0</Color>
    <Color x:Key="BorderColorExtraLight">#F2F4F7</Color>

    <!-- ============ 标题栏（扁平化：中性悬停 + 危险红关闭） ============ -->
    <Color x:Key="TitleBarBgStart">#F3F4F6</Color>
    <Color x:Key="TitleBarBgEnd">#EFF1F3</Color>
    <Color x:Key="TitleBarBtnHoverMin">#E9EBEE</Color>
    <Color x:Key="TitleBarBtnHoverMin2">#DEE1E6</Color>
    <Color x:Key="TitleBarBtnHoverRefresh">#E9EBEE</Color>
    <Color x:Key="TitleBarBtnHoverRefresh2">#DEE1E6</Color>
    <Color x:Key="TitleBarBtnHoverClose">#C42B1C</Color>
    <Color x:Key="TitleBarBtnHoverClose2">#D13438</Color>

    <!-- ============ 宠物暖色体系 ============ -->
    <Color x:Key="PetBubbleBorderDefault">#59FFB74D</Color>
    <Color x:Key="PetBubbleBgStart">#FFF8F0</Color>
    <Color x:Key="PetBubbleBgEnd">#FFF5EE</Color>
    <Color x:Key="PetBubbleTitleColor">#5D4037</Color>
    <Color x:Key="PetBubbleContentColor">#6D4C41</Color>
    <Color x:Key="PetBubbleCloseColor">#BCAAA4</Color>
    <!-- 等级边框色 -->
    <Color x:Key="PetLevelAlertBorder">#FFB74D</Color>
    <Color x:Key="PetLevelWarningBorder">#FF8A65</Color>
    <Color x:Key="PetLevelForceBorder">#EF5350</Color>
    <Color x:Key="PetLevelCriticalBorder">#FF6F00</Color>

    <!-- ============ 深色主题（分时图窗） ============ -->
    <Color x:Key="DarkBgColor">#0F1420</Color>
    <Color x:Key="DarkPanelColor">#1A1F2E</Color>
    <Color x:Key="DarkBorderColor">#2A3040</Color>
    <Color x:Key="DarkTextPrimary">#E0E0E0</Color>
    <Color x:Key="DarkTextSecondary">#9099AA</Color>
    <Color x:Key="DarkGridColor">#1E2433</Color>

    <!-- ============ SolidColorBrush ============ -->
    <!-- Primary -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="{StaticResource PrimaryActiveColor}"/>
    <SolidColorBrush x:Key="PrimaryDisabledBrush" Color="{StaticResource PrimaryDisabledColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="PrimaryLighterBrush" Color="{StaticResource PrimaryLighterColor}"/>

    <!-- 语义 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="{StaticResource SuccessLightColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="{StaticResource WarningLightColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="{StaticResource DangerLightColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="{StaticResource InfoLightColor}"/>

    <!-- A 股涨跌 -->
    <SolidColorBrush x:Key="UpBrush" Color="{StaticResource UpColor}"/>
    <SolidColorBrush x:Key="UpLightBrush" Color="{StaticResource UpLightColor}"/>
    <SolidColorBrush x:Key="DownBrush" Color="{StaticResource DownColor}"/>
    <SolidColorBrush x:Key="DownLightBrush" Color="{StaticResource DownLightColor}"/>
    <SolidColorBrush x:Key="FlatBrush" Color="{StaticResource FlatColor}"/>

    <!-- 背景 -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgPageBrush" Color="{StaticResource BgPageColor}"/>
    <SolidColorBrush x:Key="BgOverlayBrush" Color="{StaticResource BgOverlayColor}"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}"/>
    <SolidColorBrush x:Key="BgSelectedBrush" Color="{StaticResource BgSelectedColor}"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextRegularBrush" Color="{StaticResource TextRegularColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="{StaticResource TextPlaceholderColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="BorderBaseBrush" Color="{StaticResource BorderColorBase}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderColorLight}"/>
    <SolidColorBrush x:Key="BorderLighterBrush" Color="{StaticResource BorderColorLighter}"/>
    <SolidColorBrush x:Key="BorderExtraLightBrush" Color="{StaticResource BorderColorExtraLight}"/>
    <!-- 兼容历史引用：部分视图误用了“BorderBrush”资源键（指代基础边框色） -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColorBase}"/>
    <!-- 语义浅边框（状态卡片/错误横幅/等级标签描边，配 Light 填充使用） -->
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A8D5A8"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E9D3AC"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F0B9B2"/>

    <!-- 标题栏 -->
    <SolidColorBrush x:Key="TitleBarBtnHoverMinBrush" Color="{StaticResource TitleBarBtnHoverMin}"/>
    <SolidColorBrush x:Key="TitleBarBtnHoverMin2Brush" Color="{StaticResource TitleBarBtnHoverMin2}"/>
    <SolidColorBrush x:Key="TitleBarBtnHoverRefreshBrush" Color="{StaticResource TitleBarBtnHoverRefresh}"/>
    <SolidColorBrush x:Key="TitleBarBtnHoverRefresh2Brush" Color="{StaticResource TitleBarBtnHoverRefresh2}"/>
    <SolidColorBrush x:Key="TitleBarBtnHoverCloseBrush" Color="{StaticResource TitleBarBtnHoverClose}"/>
    <SolidColorBrush x:Key="TitleBarBtnHoverClose2Brush" Color="{StaticResource TitleBarBtnHoverClose2}"/>

    <!-- 宠物暖色 -->
    <SolidColorBrush x:Key="PetBubbleBgStartBrush" Color="{StaticResource PetBubbleBgStart}"/>
    <SolidColorBrush x:Key="PetBubbleBgEndBrush" Color="{StaticResource PetBubbleBgEnd}"/>
    <SolidColorBrush x:Key="PetBubbleTitleBrush" Color="{StaticResource PetBubbleTitleColor}"/>
    <SolidColorBrush x:Key="PetBubbleContentBrush" Color="{StaticResource PetBubbleContentColor}"/>
    <SolidColorBrush x:Key="PetBubbleCloseBrush" Color="{StaticResource PetBubbleCloseColor}"/>

    <!-- 深色主题 -->
    <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource DarkBgColor}"/>
    <SolidColorBrush x:Key="DarkPanelBrush" Color="{StaticResource DarkPanelColor}"/>
    <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource DarkBorderColor}"/>
    <SolidColorBrush x:Key="DarkTextPrimaryBrush" Color="{StaticResource DarkTextPrimary}"/>
    <SolidColorBrush x:Key="DarkTextSecondaryBrush" Color="{StaticResource DarkTextSecondary}"/>
    <SolidColorBrush x:Key="DarkGridBrush" Color="{StaticResource DarkGridColor}"/>

    <!-- 滚动条 -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C7CBD1"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#A8ADB4"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent"/>

</ResourceDictionary>
