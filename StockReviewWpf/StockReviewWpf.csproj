<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>StockReviewWpf</AssemblyName>
    <RootNamespace>StockReviewWpf</RootNamespace>
    <Version>2.3.18</Version>
    <Company>StockReview</Company>
    <AssemblyTitle>交易助手</AssemblyTitle>
    <Product>交易助手</Product>
    <!-- 【图标角色分工·禁止更换】app.ico=双K（exe/安装器/快捷方式主程序图标）；
         tray.ico=宠物精灵图（托盘专用）。历史教训（v2.2.6）：三角色共用一个 tray.ico，
         一次"换图标"就把宠物托盘精灵图覆盖成双K。两个文件职责不同，严禁互相覆盖或合并。 -->
    <ApplicationIcon>Resources\Images\app.ico</ApplicationIcon>
    <!-- GC 优化：ServerGC + 并发回收，降低后台调度 + 截图解码的 Gen0/Gen1 堆积 -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <!-- 单文件发布（P2-8）：dotnet publish -c Release（SelfContained + win-x64 单文件 exe） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- ReadyToRun 预编译：启动速度提升 20-30%（代价：exe 增大约 15%） -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- 项目引用 -->
    <ProjectReference Include="..\StockReview.Core\StockReview.Core.csproj" />
    <!-- AI 复盘助手 Mcp 服务端：仅 Debug 建立构建顺序（CopyMcpToWpfOutput 仅 Debug 复制产物），
         ReferenceOutputAssembly=false 不向本程序集暴露其类型。
         严禁去掉 Debug 条件：Release 发布时本工程自包含，Mcp 是框架依赖 exe，
         无条件引用会触发 NETSDK1150（非自包含 exe 不能被自包含 exe 引用）；
         Release 打包由 pack.ps1 单独发布 Mcp（自包含单文件）进 publish 目录。 -->
    <ProjectReference Include="..\StockReview.Mcp\StockReview.Mcp.csproj" ReferenceOutputAssembly="false"
                      Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms 仅用于托盘/截图，移除其隐式全局 using，避免与 WPF 的 Brush/Point/MouseEventArgs 歧义 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM 框架（文档推荐：微软官方，源代码生成器） -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />

    <!-- 应用骨架（文档推荐：DI、配置、日志、后台服务统一生命周期） -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />

    <!-- 图表（文档推荐：ScottPlot 5 为主） -->
    <PackageReference Include="ScottPlot.WPF" Version="5.0.51" />

    <!-- 日志（文档推荐：Serilog 结构化日志） -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />

    <!-- 打包（文档推荐：单文件 exe + 增量自动更新） -->
    <PackageReference Include="Velopack" Version="0.0.942" />

    <!-- WebDAV -->
    <PackageReference Include="WebDav.Client" Version="2.3.0" />

    <!-- 离线 OCR 识别（股票代码/数字识别，本地引擎，无云端依赖） -->
    <PackageReference Include="Tesseract" Version="5.2.0" />

    <!-- WebP 解码（宠物精灵图集来自 awesome-codex-pet，仅提供 .webp） -->
    <PackageReference Include="Imazen.WebP" Version="11.0.0" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.win-x64" Version="1.6.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 更新源配置（UpdateService 读取安装目录该文件发现更新；指向本地发布目录 Releases） -->
    <Content Include="update-source.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 打包 tessdata 训练数据到输出目录（OCR 引擎运行时依赖） -->
    <Content Include="tessdata\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 股票代码→名称映射（OCR 模糊纠错用） -->
    <Content Include="Resources\stockList.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 默认宠物精灵（对应原版 data/pets/firefly（lingxiaotian），首启播种到 DataDir\pets） -->
    <Content Include="Resources\Pets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 宠物托盘图标：精灵图（TrayService 运行时查找，勿换图标勿指向 app.ico） -->
    <Content Include="Resources\Images\tray.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- AI 复盘助手提示词：设置页"激活提示词"读取源；ExcludeFromSingleFile 防止 bundle 误判为 NativeBinary 嵌入 exe -->
    <Content Include="Resources\llm-review-prompt.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- 日记展示风格预览图（对应原版 /design/design-*.jpg，显示设置页使用） -->
    <Content Include="Assets\Design\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- wangeditor 富文本编辑器（原版同款，心得/日记编辑，离线本地资源） -->
    <Content Include="Assets\Editor\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 前端 dist 静态资源（WebView2 统计汇总/每日擒牛 嵌入页） -->
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 打包级排除：ort-dist（ONNX Runtime wasm，38.9MB）与 models（digit-recognizer.onnx）
         仅供旧版 OCR 截图识别增强使用。WPF 版 OCR 走原生 Tesseract，
         且 shim 的 getResourcesPath 返回空串使 ORT 必然走 file:/// 分支加载失败，
         两张图表页（daily-pick/statistics）的实际流程到不了 ORT。源目录保留，仅不进安装包。 -->
    <Content Remove="wwwroot\ort-dist\**\*" />
    <Content Remove="wwwroot\models\**\*" />
  </ItemGroup>

  <ItemGroup>
    <!-- 单文件发布豁免：这些内容文件会被 bundle 误判为 NativeBinary 强制嵌入 exe（单文件诊断日志：
         Embed: Resources/Pets/.../spritesheet.png [NativeBinary] / wwwroot/icon-bg.ico [NativeBinary]），
         导致 publish 目录缺失、运行时热替换失效。ExcludeFromSingleFile 使其留在 publish 目录。
         原生依赖（Tesseract/WebP 的 dll）不受影响，仍按 IncludeNativeLibrariesForSelfExtract 自解压。 -->
    <Content Update="Resources\Pets\**\spritesheet.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Update="wwwroot\icon.ico;wwwroot\icon.png;wwwroot\icon-bg.ico;wwwroot\icon-transparent.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- 仅 Debug：把 StockReview.Mcp 的构建产物（exe + 依赖 dll）复制进 WPF 输出目录，
       使 F5 运行时 AppBaseDir 下即存在 StockReview.Mcp.exe 供自检；ReferenceOutputAssembly=false 已保证构建顺序 -->
  <Target Name="CopyMcpToWpfOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <McpOutput Include="..\StockReview.Mcp\bin\$(Configuration)\net10.0-windows\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(McpOutput)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>