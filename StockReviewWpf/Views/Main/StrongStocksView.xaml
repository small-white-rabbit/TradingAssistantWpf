<UserControl x:Class="StockReviewWpf.Views.Main.StrongStocksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StockReviewWpf.Views.Main"
             xmlns:controls="clr-namespace:StockReviewWpf.Views.Pet.Controls"
             xmlns:ui="clr-namespace:StockReviewWpf.Controls"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 日期徽章渐变（原版 .day-badge: #409eff → #66b1ff） -->
        <LinearGradientBrush x:Key="StrongDayBadgeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#409EFF" Offset="0"/>
            <GradientStop Color="#66B1FF" Offset="1"/>
        </LinearGradientBrush>
        <!-- 日期横线渐变（原版 .day-line: 90deg #e4e7ed → transparent） -->
        <LinearGradientBrush x:Key="StrongDayLineBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E4E7ED" Offset="0"/>
            <GradientStop Color="#E4E7ED" Offset="0.5"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </LinearGradientBrush>

        <!-- 强股卡片（原版 el-card：白底、1px #e4e7ed 边、4px 圆角、body 内边距 15/15/0/15，
             .stock-card 阴影 0 4px 16px rgba(0,0,0,.08)、:hover 0 8px 32px rgba(0,0,0,.15)） -->
        <Style x:Key="StrongStockCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E7ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15,15,15,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.08" Color="Black"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.15" Color="Black"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 添加/编辑共用表单 -->
        <DataTemplate x:Key="StockFormTemplate">
            <StackPanel>
                <!-- 日期：文字与日期选择栏同行居中对齐 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="日期" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <controls:ElDatePicker Width="180" SelectedDate="{Binding Form.Date, Converter={StaticResource DateTimeStr}, Mode=TwoWay}"
                            DateSelected="FormDate_Changed" ToolTip="切换日期后自动回填该日行情"/>
                </StackPanel>

                <TextBlock Text="股票代码" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,10" LastChildFill="True">
                    <Button Style="{StaticResource SmallDefaultButton}" Content="粘贴截图" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top"
                            Click="PasteScreenshot_Click"/>
                    <Border Height="160" BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="2" CornerRadius="6"
                            Background="{StaticResource BgBrush}" Cursor="Hand" MouseLeftButtonDown="ScreenshotArea_Click">
                        <Grid>
                            <Image Source="{Binding Form.ScreenshotDisplay, Converter={StaticResource Base64Image}}" Stretch="Uniform" Margin="4"
                                   Visibility="{Binding Form.ScreenshotDisplay, Converter={StaticResource NotNullToVis}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Form.ScreenshotDisplay, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="📷 点击或粘贴截图" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsOcrLoading, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="⏳ 正在识别股票代码..." FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- 股票代码 + 股票名称同一行 -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="股票代码" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Height="28" VerticalContentAlignment="Center" Text="{Binding Form.StockCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="6"
                                 KeyDown="StockInput_KeyDown" ToolTip="输入6位代码后回车自动回填行情"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="股票名称" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Height="28" VerticalContentAlignment="Center" Text="{Binding Form.StockName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="StockInput_KeyDown" ToolTip="输入名称后回车自动匹配股票并回填行情"/>
                    </StackPanel>
                </Grid>

                <!-- 收盘价 / 涨跌幅 / 最高价 / 最大涨幅同一行（4 等分） -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="收盘价" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Height="28" VerticalContentAlignment="Center" Text="{Binding Form.ClosePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                        <TextBlock Text="涨跌幅%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Height="28" VerticalContentAlignment="Center" Text="{Binding Form.ChangePct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="6,0,6,0">
                        <TextBlock Text="最高价" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Height="28" VerticalContentAlignment="Center" Text="{Binding Form.HighPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="6,0,0,0">
                        <TextBlock Text="最大涨幅%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Height="28" VerticalContentAlignment="Center" Text="{Binding Form.MaxChangePct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- 强势类型（分组按钮：父类名 + 子类同一行，对齐每日擒牛进场类型布局） -->
                <TextBlock Text="强势类型" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding EntryTypeTree}" Margin="0,0,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <WrapPanel>
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextRegularBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,8" MinWidth="56"
                                               Text="{Binding Name, StringFormat={}{0}：}"/>
                                    <Button Margin="0,0,8,8" Padding="10,4" FontSize="12" VerticalAlignment="Center"
                                            Command="{Binding DataContext.SelectStrongTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                            CommandParameter="{Binding Name}"
                                            Visibility="{Binding HasChildren, Converter={StaticResource InverseBoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TypeOptionButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource MultiEquals}">
                                                                <Binding Path="Name"/>
                                                                <Binding Path="DataContext.Form.StrongType" RelativeSource="{RelativeSource AncestorType=ItemsControl, AncestorLevel=2}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="ui:ButtonHelper.IsSelected" Value="True"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding Name}"/>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Children}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,8,8" Padding="10,4" FontSize="12" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.SelectStrongTypeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                        CommandParameter="{Binding Name}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource TypeOptionButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <MultiBinding Converter="{StaticResource MultiEquals}">
                                                                            <Binding Path="Name"/>
                                                                            <Binding Path="DataContext.Form.StrongType" RelativeSource="{RelativeSource AncestorType=ItemsControl, AncestorLevel=2}"/>
                                                                        </MultiBinding>
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="ui:ButtonHelper.IsSelected" Value="True"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!-- 月份按钮：Tag 存月份值；选中态经 TypeOptionButton 模板处理，避免悬停/按下时看不清 -->
        <Style x:Key="MonthBtn" TargetType="Button" BasedOn="{StaticResource TypeOptionButton}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource MultiEquals}">
                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                            <Binding Path="ActiveMonth"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="ui:ButtonHelper.IsSelected" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== 时间选择�?sticky 栏（复用交易记录筛�?�条样式�?========== -->
        <Border Grid.Row="0" Background="White" Padding="20,12"
                BorderBrush="#E3E6EA" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical">

                <!-- �?行：年份切换 + 月份按钮 + 右侧操作 -->
                <DockPanel>
                    <!-- 年份切换（同交易记录�?-->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource SmallDefaultButton}" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                Width="30" Height="30" Padding="0"
                                Command="{Binding ChangeYearCommand}" CommandParameter="-1"/>
                        <TextBlock VerticalAlignment="Center" Margin="10,0" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding CurrentYear}"/><Run Text=""/>
                        </TextBlock>
                        <Button Style="{StaticResource SmallDefaultButton}" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                Width="30" Height="30" Padding="0"
                                Command="{Binding ChangeYearCommand}" CommandParameter="1"/>
                    </StackPanel>

                    <!-- 右侧操作�?-->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="12" FontWeight="Medium" Foreground="{StaticResource ElTextSecondaryBrush}">
                            <Run Text="共 "/>
                            <Run Text="{Binding FilteredStrongStocksCount}"/>
                            <Run Text=" "/>
                        </TextBlock>

                        <Border Style="{StaticResource SegmentGroup}" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="卡片" GroupName="ViewMode" Style="{StaticResource SegmentItem}"
                                             IsChecked="{Binding ViewMode, Converter={StaticResource TabCheckConverter}, ConverterParameter=card}"/>
                                <RadioButton Content="列表" GroupName="ViewMode" Style="{StaticResource SegmentItem}"
                                             IsChecked="{Binding ViewMode, Converter={StaticResource TabCheckConverter}, ConverterParameter=list}"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SmallPrimaryButton}" Content="添加强股"
                                Command="{Binding ShowAddDialogCommand}"/>
                    </StackPanel>

                    <!-- 月份按钮：全部在�?+ 1-12月（同交易�?录） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Button Content="全部" Style="{StaticResource SmallDefaultButton}"
                                Margin="0,0,6,0" Command="{Binding ShowAllMonthsCommand}"/>
                        <WrapPanel>
                            <Button Style="{StaticResource MonthBtn}" Content="1月" Tag="1" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="1"/>
                            <Button Style="{StaticResource MonthBtn}" Content="2月" Tag="2" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="2"/>
                            <Button Style="{StaticResource MonthBtn}" Content="3月" Tag="3" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="3"/>
                            <Button Style="{StaticResource MonthBtn}" Content="4月" Tag="4" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="4"/>
                            <Button Style="{StaticResource MonthBtn}" Content="5月" Tag="5" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="5"/>
                            <Button Style="{StaticResource MonthBtn}" Content="6月" Tag="6" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="6"/>
                            <Button Style="{StaticResource MonthBtn}" Content="7月" Tag="7" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="7"/>
                            <Button Style="{StaticResource MonthBtn}" Content="8月" Tag="8" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="8"/>
                            <Button Style="{StaticResource MonthBtn}" Content="9月" Tag="9" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="9"/>
                            <Button Style="{StaticResource MonthBtn}" Content="10月" Tag="10" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="10"/>
                            <Button Style="{StaticResource MonthBtn}" Content="11月" Tag="11" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="11"/>
                            <Button Style="{StaticResource MonthBtn}" Content="12月" Tag="12" Margin="0,0,5,0" Padding="9,4" FontSize="13" FontWeight="SemiBold"
                                    Command="{Binding SelectMonthCommand}" CommandParameter="12"/>
                        </WrapPanel>
                    </StackPanel>

                    <Border/>
                </DockPanel>

                <!-- �?行：日期条（紧凑胶囊样式，同交易记录�?-->
                <ScrollViewer
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Margin="0,8,0,0" Padding="0,0,0,2" MaxHeight="30">
                    <ItemsControl ItemsSource="{Binding DayCells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2,0" Padding="5,2" CornerRadius="4" Cursor="Hand">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource DateHighlight}">
                                            <Binding Path="DateStr"/>
                                            <Binding Path="DataContext.SelectedDate" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="13" MinWidth="24" TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#9DA3AB"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasData}" Value="True">
                                                            <Setter Property="Foreground" Value="#40444A"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding Day, Mode=OneWay}"/>
                                        </TextBlock>

                                    </StackPanel>
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding DateStr}"/>
                                    </Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ========== 内�?�?========== -->
        <Grid Grid.Row="1">

            <!-- 卡片视图（虚拟化 + 平滑滚动：仅渲染可视区域的日期组。
                 ItemsControl 必须自带 ScrollViewer 模板——若外层再包 ScrollViewer，
                 面板收到无限高度约束，虚拟化会失效） -->
            <ItemsControl ItemsSource="{Binding DayGroups}"
                          Visibility="{Binding ViewMode, Converter={StaticResource StringEqualsToVis}, ConverterParameter=card}"
                          Background="#EFF1F3"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="PART_Scroll" Background="{TemplateBinding Background}" Padding="20,16,20,0"
                                      VerticalScrollBarVisibility="Auto" CanContentScroll="True"
                                      PanningMode="VerticalOnly"
                                      ui:SmoothScrollBehavior.IsEnabled="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,24">
                                <!-- 日期�?（原版 .day-badge：渐变+蓝色投影；.day-line：渐变横线） -->
                                <DockPanel VerticalAlignment="Center" Margin="0,0,0,12">
                                    <Border Width="50" Height="50" Background="{StaticResource StrongDayBadgeBrush}" CornerRadius="10" Margin="0,0,15,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#409EFF"/>
                                        </Border.Effect>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="White">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1}">
                                                        <Binding Path="Day"/><Binding Path="Month"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{Binding WeekDay}" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium" Foreground="White" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Rectangle Height="2" Fill="{StaticResource StrongDayLineBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- 当日股票卡片 -->
                                <WrapPanel>
                                    <ItemsControl ItemsSource="{Binding Stocks}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StrongStockCard}" Width="600" Margin="0,0,20,20">
                                                    <Border.InputBindings>
                                                        <MouseBinding Gesture="LeftDoubleClick"
                                                                      Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel>
                                                        <!-- 头部（原版 .stock-name 16px/700/#303133、.stock-code 12px/500/#909399） -->
                                                        <DockPanel Margin="0,0,0,12">
                                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                <TextBlock Text="{Binding StockName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ElTextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding StockCode}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource ElTextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>

                                                        <!-- 价格�?（原版 .card-price 13px/#606266/500，涨跌幅红涨绿跌） -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource ElTextRegularBrush}" Text="HHV " VerticalAlignment="Center" Margin="0,0,0,0"/>
                                                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource ElTextRegularBrush}" Text="{Binding HighPriceText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                            <TextBlock FontSize="12" Foreground="{StaticResource ElTextSecondaryBrush}" Text="最大涨幅" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{Binding MaxChangePct, Converter={StaticResource UpDownBrush}, ConverterParameter=#F56C6C|#67C23A}" VerticalAlignment="Center">
                                                                <Run Text="{Binding MaxChangePctText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <!-- 状�?�标�?（原版：strongType warning、已关联 success、未关联 info，el-tag small 配色） -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <Border Style="{StaticResource ElTagWarning}" Visibility="{Binding StrongType, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding StrongType}" FontSize="12" Foreground="{StaticResource ElWarningBrush}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource ElTagSuccess}" Visibility="{Binding HasRelated, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="已关联" FontSize="12" Foreground="{StaticResource ElSuccessBrush}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource ElTagInfo}" Visibility="{Binding HasRelated, Converter={StaticResource InverseBoolToVis}}">
                                                                <TextBlock Text="未关联" FontSize="12" Foreground="{StaticResource ElInfoBrush}"/>
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- �?��（原版 img 720x580 contain、6px 圆角） -->
                                                        <Border Visibility="{Binding DisplayScreenshot, Converter={StaticResource NotNullToVis}}" Margin="0,0,0,0" CornerRadius="6">
                                                            <Image Source="{Binding DisplayScreenshot, Converter={StaticResource Base64Image}}" MaxHeight="580" Stretch="Uniform" Cursor="Hand"
                                                                   Loaded="CardImage_Loaded" DataContextChanged="CardImage_DataContextChanged">
                                                                <Image.InputBindings>
                                                                    <MouseBinding Gesture="LeftClick"
                                                                                  Command="{Binding DataContext.PreviewImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                  CommandParameter="{Binding}"/>
                                                                </Image.InputBindings>
                                                            </Image>
                                                        </Border>

                                                        <!-- 操作 -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,10">
                                                            <Button Style="{StaticResource SmallPrimaryButton}" Content="关联" FontSize="12" Padding="8,2" Margin="0,0,6,0"
                                                                    Visibility="{Binding HasRelated, Converter={StaticResource InverseBoolToVis}}"
                                                                    Command="{Binding DataContext.LinkTradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource SmallSuccessButton}" Content="查看" FontSize="12" Padding="8,2" Margin="0,0,6,0"
                                                                    Visibility="{Binding HasRelated, Converter={StaticResource BoolToVis}}"
                                                                    Command="{Binding DataContext.ViewRelatedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                            <Button Style="{StaticResource SmallDangerButton}" Content="删除" FontSize="12" Padding="8,2"
                                                                    Command="{Binding DataContext.DeleteStrongStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ========== 列表视图 ========== -->
            <Border Style="{StaticResource CardPanel}"
                    Visibility="{Binding ViewMode, Converter={StaticResource StringEqualsToVis}, ConverterParameter=list}"
                    Margin="20,16,20,20">
                    <DataGrid ItemsSource="{Binding StrongStocks}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource ElTable}"
                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                              RowStyle="{StaticResource ElTableRow}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="排名" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=DisplayIndex}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="代码" Binding="{Binding StockCode}" Width="90"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding StockName}" Width="*"/>
                            <DataGridTextColumn Header="最高价" Binding="{Binding HighPriceText}" Width="100"/>
                            <DataGridTemplateColumn Header="最大涨幅" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MaxChangePctText}" Foreground="{Binding MaxChangePct, Converter={StaticResource UpDownBrush}, ConverterParameter=#F56C6C|#67C23A}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="强势类型" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ElTagWarning}" Visibility="{Binding StrongType, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}">
                                            <TextBlock Text="{Binding StrongType}" FontSize="12" Foreground="{StaticResource ElWarningBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="关联状态" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="已关" Foreground="{StaticResource ElSuccessBrush}" HorizontalAlignment="Center"
                                                   Visibility="{Binding HasRelated, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SmallPrimaryButton}" Content="关联" FontSize="12" Padding="8,2" Margin="0,0,6,0"
                                                    Visibility="{Binding HasRelated, Converter={StaticResource InverseBoolToVis}}"
                                                    Command="{Binding DataContext.LinkTradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource SmallSuccessButton}" Content="查看" FontSize="12" Padding="8,2" Margin="0,0,6,0"
                                                    Visibility="{Binding HasRelated, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ViewRelatedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{StaticResource SmallDangerButton}" Content="删除" FontSize="12" Padding="8,2"
                                                    Command="{Binding DataContext.DeleteStrongStockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

        </Grid>

        <!-- ========== 添加弹窗 ========== -->
        <Border x:Name="AddDialogOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsAddDialogVisible, Converter={StaticResource BoolToVis}}"
                ui:DialogOverlayBehavior.CloseOnEsc="IsAddDialogVisible"
                ui:DialogAnimation.Enable="True"
                MouseLeftButtonDown="Overlay_Click">
            <Border Background="White" CornerRadius="8" Padding="20" MaxWidth="520" MaxHeight="640"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="添加强势股" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StockFormTemplate}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource SmallDefaultButton}" Content="取消" Margin="0,0,8,0" Click="CloseAddDialog_Click"/>
                            <Button Style="{StaticResource SmallPrimaryButton}" Content="添加" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- ========== 编辑弹窗 ========== -->
        <Border x:Name="EditDialogOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsEditDialogVisible, Converter={StaticResource BoolToVis}}"
                ui:DialogOverlayBehavior.CloseOnEsc="IsEditDialogVisible"
                ui:DialogAnimation.Enable="True"
                MouseLeftButtonDown="Overlay_Click">
            <Border Background="White" CornerRadius="8" Padding="20" MaxWidth="520" MaxHeight="640"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="编辑强势股" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StockFormTemplate}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Style="{StaticResource SmallDefaultButton}" Content="取消" Margin="0,0,8,0" Click="CloseEditDialog_Click"/>
                            <Button Style="{StaticResource SmallPrimaryButton}" Content="保存" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- ========== 关联弹窗 ========== -->
        <Border x:Name="LinkDialogOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsLinkDialogVisible, Converter={StaticResource BoolToVis}}"
                ui:DialogOverlayBehavior.CloseOnEsc="IsLinkDialogVisible"
                ui:DialogAnimation.Enable="True"
                MouseLeftButtonDown="Overlay_Click">
            <Border Background="White" CornerRadius="8" Padding="20" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <StackPanel>
                    <TextBlock Text="关联自有记录" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding LinkingStock, Converter={StaticResource NotNullToVis}}">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding LinkingStock.StockName}"/><Run Text=" "/><Run Text="{Binding LinkingStock.StockCode}"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="最高价: "/><Run Text="{Binding LinkingStock.HighPriceText, Mode=OneWay}"/>
                            <Run Text="   最大涨幅: "/><Run Text="{Binding LinkingStock.MaxChangePctText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Separator Margin="0,12,0,8"/>
                    <TextBlock Text="选择要关联的记录：" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding MyTradesForStock}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource ElTable}" ColumnHeaderStyle="{StaticResource ElTableHeader}" RowStyle="{StaticResource ElTableRow}" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding TradeDate}" Width="110"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding EntryType}" Width="90"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding PositionStatus}" Width="90"/>
                            <DataGridTemplateColumn Header="收益%" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalReturn, StringFormat={}{0:0.00}}" Foreground="{Binding TotalReturn, Converter={StaticResource UpDownBrush}}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SmallPrimaryButton}" Content="关联" FontSize="12" Padding="8,2"
                                                Command="{Binding DataContext.SelectTradeToLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource SmallDefaultButton}" Content="关闭" Click="CloseLinkDialog_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========== 查看关联弹窗 ========== -->
        <Border x:Name="ViewDialogOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsViewDialogVisible, Converter={StaticResource BoolToVis}}"
                ui:DialogOverlayBehavior.CloseOnEsc="IsViewDialogVisible"
                ui:DialogAnimation.Enable="True"
                MouseLeftButtonDown="Overlay_Click">
            <Border Background="White" CornerRadius="8" Padding="20" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <StackPanel>
                    <TextBlock Text="关联详情" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <StackPanel Visibility="{Binding ViewingStock, Converter={StaticResource NotNullToVis}}">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding ViewingStock.StockName}"/><Run Text=" "/><Run Text="{Binding ViewingStock.StockCode}"/>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="最高价: "/><Run Text="{Binding ViewingStock.HighPriceText, Mode=OneWay}"/>
                            <Run Text="   最大涨幅: "/><Run Text="{Binding ViewingStock.MaxChangePctText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Separator Margin="0,12,0,8"/>
                    <TextBlock Text="你的记录：" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ViewingRelatedTrades}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardPanelCompact}" Margin="0,0,0,8" Padding="12">
                                    <StackPanel>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="日期: "/><Run Text="{Binding TradeDate}"/>
                                            <Run Text="   类型: "/><Run Text="{Binding EntryType}"/>
                                            <Run Text="   状态: "/><Run Text="{Binding PositionStatus}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="收益: " VerticalAlignment="Center"/>
                                            <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                                       Foreground="{Binding TotalReturn, Converter={StaticResource UpDownBrush}}">
                                                <Run Text="{Binding TotalReturn, StringFormat={}{0:0.00}}"/><Run Text="%"/>
                                            </TextBlock>
                                            <Button Style="{StaticResource SmallPrimaryButton}" Content="查看记录" FontSize="12" Padding="8,2" Margin="12,0,0,0"
                                                    Command="{Binding DataContext.GoToTradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource SmallDefaultButton}" Content="关闭" Click="CloseViewDialog_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ========== 图片预�?弹窗 ========== -->
        <Border x:Name="ImagePreviewOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#CC000000" Visibility="{Binding IsImagePreviewVisible, Converter={StaticResource BoolToVis}}"
                ui:DialogOverlayBehavior.CloseOnEsc="IsImagePreviewVisible"
                ui:DialogAnimation.Enable="True"
                MouseLeftButtonDown="PreviewOverlay_Click">
            <Grid>
                <Image Source="{Binding PreviewImageUrl, Converter={StaticResource Base64Image}, ConverterParameter=full}" MaxWidth="1100" MaxHeight="800"
                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Style="{StaticResource SmallDefaultButton}" Content="✕" Width="36" Height="36" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Click="CloseImagePreview_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
