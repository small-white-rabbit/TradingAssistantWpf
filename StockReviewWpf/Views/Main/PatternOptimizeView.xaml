<UserControl x:Class="StockReviewWpf.Views.Main.PatternOptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StockReviewWpf.Converters"
             xmlns:controls="clr-namespace:StockReviewWpf.Views.Pet.Controls"
             xmlns:ui="clr-namespace:StockReviewWpf.Controls"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ===== 左侧类型导航�?===== -->
        <Style x:Key="TypeItemBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding IsStrongType}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                        <Condition Binding="{Binding IsStrongType}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource WarningLightBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                        <Condition Binding="{Binding IsStrongType}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeItemText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextRegularBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChild}" Value="True">
                    <Setter Property="FontSize" Value="12"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsStrongType}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeItemCountBorder" TargetType="Border">
            <Setter Property="Background" Value="#EFF1F3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#55FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeItemCountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 概�? tile 区块�?===== -->
        <Style x:Key="TileBlockHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>

        <Style x:Key="TileBlockBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <!-- 背景=White 使整块区域可命中（WPF 中 Background=null 的区域不参与 hit-test，
                 双击空白处事件无法路由到 Border，表现为“双击没反应”）。对齐 Electron tile-block 整块可双击 -->
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- ===== �?减分项标�?===== -->
        <Style x:Key="PlusItemTag" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource UpLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource UpBrush}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="MinusItemTag" TargetType="Border" BasedOn="{StaticResource PlusItemTag}">
            <Setter Property="Background" Value="{StaticResource DownLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DownBrush}"/>
        </Style>

        <!-- ===== 空提�?===== -->
        <Style x:Key="TileEmpty" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9DA3AB"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>

        <!-- ===== 案例卡片 ===== -->
        <Style x:Key="CaseCard" TargetType="Border">
            <Setter Property="Width" Value="210"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E6EA"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsInCompare}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 对比弹窗缩放圆钮 -->
        <Style x:Key="ZoomCircleBtn" TargetType="Button" BasedOn="{StaticResource SmallDefaultButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 页面标�? -->
        <TextBlock Grid.Row="0" Text="模式优化" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="20,16,0,12"/>

        <!-- 左右布局 -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧 sidebar：模式类�?===== -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E3E6EA" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#E3E6EA" BorderThickness="0,0,0,1" Padding="16,12">
                        <TextBlock Text="模式类型" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TypeNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MouseLeftButtonDown="TypeItem_MouseDown" Tag="{Binding}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource TypeItemBorder}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                        <Setter Property="Padding" Value="32,6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource TypeItemCountBorder}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding TotalCount}" Style="{StaticResource TypeItemCountText}"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsStrongType}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding TypeName}" Style="{StaticResource TypeItemText}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== 右侧 main-content ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                <!-- ========== 模式概�?（未选类型时�?========== -->
                <StackPanel Visibility="{Binding IsTypeSelected, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                        <TextBlock Text="模式概览" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" Margin="16,2,0,0" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="共"/><Run Text="{Binding OverviewTotal, Mode=OneWay}"/><Run Text=" 个模式类型，综合成功率 "/>
                            <Run Text="{Binding OverviewAvgRate, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding OverviewList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6"
                                        Margin="0,0,0,16" ClipToBounds="True">
                                    <StackPanel>
                                        <!-- 标�?�?-->
                                        <Border Background="#F5F5F5" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="16,10">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="查看案例" Style="{StaticResource SmallPrimaryButton}"
                                                        Command="{Binding DataContext.SelectOverviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" HorizontalAlignment="Right"/>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⚡" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                                               Foreground="{StaticResource WarningBrush}"
                                                               Visibility="{Binding IsParent, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding TypeName}" FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock FontSize="12" Foreground="{StaticResource TextRegularBrush}">
                                                            <Run Text="{Binding SuccessCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource UpBrush}"/><Run Text="成功 "/>
                                                            <Run Text="{Binding FailCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource DownBrush}"/><Run Text="失败 "/>
                                                            <Run Text="{Binding SuccessRate, Mode=OneWay}" FontWeight="SemiBold"
                                                                 Foreground="{Binding SuccessRate, Converter={StaticResource SuccessRateBrush}}"/><Run Text="%成功率"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- �?��区块拼接：图�?550 | 加分 | 减分 | 思�??| 案例排�? -->
                                        <Grid MinHeight="200">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="550"/>
                                                <ColumnDefinition Width="*" MinWidth="100"/>
                                                <ColumnDefinition Width="*" MinWidth="100"/>
                                                <ColumnDefinition Width="*" MinWidth="100"/>
                                                <ColumnDefinition Width="*" MinWidth="100"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 区块1：标准形�?类型图示（标签页+滚轮切换，点击�?览） -->
                                            <Border Grid.Column="0" x:Name="TileFormBlock" Style="{StaticResource TileBlockBorder}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" x:Name="TileTabStandard" Background="#F0F0F0"
                                                                BorderBrush="#D0D0D0" BorderThickness="0,0,1,0" Cursor="Hand"
                                                                MouseLeftButtonDown="TileTab_MouseLeftButtonDown">
                                                            <TextBlock Text="标准形" FontSize="12" HorizontalAlignment="Center" Margin="0,8"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <Border Grid.Column="1" x:Name="TileTabType" Background="#F0F0F0"
                                                                Cursor="Hand" MouseLeftButtonDown="TileTab_MouseLeftButtonDown">
                                                            <TextBlock Text="类型图示" FontSize="12" HorizontalAlignment="Center" Margin="0,8"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                    <Border x:Name="TileImageArea" Height="450" Background="#F5F5F5" Cursor="Hand"
                                                            ClipToBounds="True" Loaded="TileImageArea_Loaded"
                                                            MouseLeftButtonDown="TileImageArea_MouseLeftButtonDown">
                                                        <Grid>
                                                            <Image x:Name="TileImgStandard" Stretch="Uniform"
                                                                   Source="{Binding StandardFormImage, Converter={StaticResource Base64Image}, ConverterParameter=full}"/>
                                                            <Image x:Name="TileImgType" Stretch="Uniform" Visibility="Collapsed"
                                                                   Source="{Binding TypeImage, Converter={StaticResource Base64Image}, ConverterParameter=full}"/>
                                                            <TextBlock x:Name="TileImgEmpty" Text="暂无图示" FontSize="12"
                                                                       Foreground="#9DA3AB" HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- 区块2：加分项（双击�?内编辑） -->
                                            <Border Grid.Column="1" Style="{StaticResource TileBlockBorder}" Tag="plus"
                                                    PreviewMouseLeftButtonDown="TileBlock_MouseLeftButtonDown">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                                        <TextBlock Text="✅ 加分项" Style="{StaticResource TileBlockHead}" Foreground="{StaticResource UpBrush}"/>
                                                    </Border>
                                                    <Grid Margin="10">
                                                        <!-- 显示模式 -->
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                                                            <ScrollViewer.Style>
                                                                <Style TargetType="ScrollViewer">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EditingField}" Value="plus">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ScrollViewer.Style>
                                                            <StackPanel>
                                                                <ItemsControl ItemsSource="{Binding PlusItems}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource PlusItemTag}">
                                                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                                                           Foreground="{StaticResource UpBrush}"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="双击编辑" Style="{StaticResource TileEmpty}"
                                                                           Visibility="{Binding PlusItems.Count, Converter={StaticResource IntIsZeroToVis}}"/>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                        <!-- 编辑模式 -->
                                                        <DockPanel Visibility="{Binding EditingField, Converter={StaticResource StringEqualsToVis}, ConverterParameter=plus}">
                                                            <Border DockPanel.Dock="Bottom" Background="#FAFBFC" BorderBrush="#E3E6EA"
                                                                    BorderThickness="0,1,0,0" Padding="8" Margin="-10,-10,-10,-10">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Content="取消" Style="{StaticResource SmallDefaultButton}" Margin="0,0,8,0"
                                                                            Command="{Binding DataContext.CancelTileEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                    <Button Content="保存" Style="{StaticResource SmallPrimaryButton}"
                                                                            Command="{Binding DataContext.SaveTileEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBox Text="{Binding DataContext.EditingContent, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" FontSize="12"
                                                                     VerticalScrollBarVisibility="Auto" Background="White"/>
                                                        </DockPanel>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>

                                            <!-- 区块3：减分项 -->
                                            <Border Grid.Column="2" Style="{StaticResource TileBlockBorder}" Tag="minus"
                                                    PreviewMouseLeftButtonDown="TileBlock_MouseLeftButtonDown">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                                        <TextBlock Text="❌ 减分项" Style="{StaticResource TileBlockHead}" Foreground="{StaticResource DownBrush}"/>
                                                    </Border>
                                                    <Grid Margin="10">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                                                            <ScrollViewer.Style>
                                                                <Style TargetType="ScrollViewer">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EditingField}" Value="minus">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ScrollViewer.Style>
                                                            <StackPanel>
                                                                <ItemsControl ItemsSource="{Binding MinusItems}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource MinusItemTag}">
                                                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                                                           Foreground="{StaticResource DownBrush}"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="双击编辑" Style="{StaticResource TileEmpty}"
                                                                           Visibility="{Binding MinusItems.Count, Converter={StaticResource IntIsZeroToVis}}"/>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                        <DockPanel Visibility="{Binding EditingField, Converter={StaticResource StringEqualsToVis}, ConverterParameter=minus}">
                                                            <Border DockPanel.Dock="Bottom" Background="#FAFBFC" BorderBrush="#E3E6EA"
                                                                    BorderThickness="0,1,0,0" Padding="8" Margin="-10,-10,-10,-10">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Content="取消" Style="{StaticResource SmallDefaultButton}" Margin="0,0,8,0"
                                                                            Command="{Binding DataContext.CancelTileEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                    <Button Content="保存" Style="{StaticResource SmallPrimaryButton}"
                                                                            Command="{Binding DataContext.SaveTileEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBox Text="{Binding DataContext.EditingContent, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" FontSize="12"
                                                                     VerticalScrollBarVisibility="Auto" Background="White"/>
                                                        </DockPanel>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>

                                            <!-- 区块4：�?��?�（双击行内编辑�?-->
                                            <Border Grid.Column="3" Style="{StaticResource TileBlockBorder}" Tag="reflection"
                                                    PreviewMouseLeftButtonDown="TileBlock_MouseLeftButtonDown">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                                        <TextBlock Text="💭 思考" Style="{StaticResource TileBlockHead}"/>
                                                    </Border>
                                                    <Grid Margin="10">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                                                            <ScrollViewer.Style>
                                                                <Style TargetType="ScrollViewer">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EditingField}" Value="reflection">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ScrollViewer.Style>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding ReflectionsPlain}" FontSize="12" TextWrapping="Wrap"
                                                                           Foreground="{StaticResource TextRegularBrush}"
                                                                           Visibility="{Binding Reflections, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}"/>
                                                                <TextBlock Text="双击编辑" Style="{StaticResource TileEmpty}"
                                                                           Visibility="{Binding Reflections, Converter={StaticResource NotNullToVis}, ConverterParameter='inverse,notEmpty'}"/>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                        <DockPanel Visibility="{Binding EditingField, Converter={StaticResource StringEqualsToVis}, ConverterParameter=reflection}">
                                                            <Border DockPanel.Dock="Bottom" Background="#FAFBFC" BorderBrush="#E3E6EA"
                                                                    BorderThickness="0,1,0,0" Padding="8" Margin="-10,-10,-10,-10">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                    <Button Content="取消" Style="{StaticResource SmallDefaultButton}" Margin="0,0,8,0"
                                                                            Command="{Binding DataContext.CancelTileEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                    <Button Content="保存" Style="{StaticResource SmallPrimaryButton}"
                                                                            Command="{Binding DataContext.SaveTileEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                </StackPanel>
                                                            </Border>
                                                            <TextBox Text="{Binding DataContext.EditingContent, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                                     AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" FontSize="12"
                                                                     VerticalScrollBarVisibility="Auto" Background="White"/>
                                                        </DockPanel>
                                                    </Grid>
                                                </DockPanel>
                                            </Border>

                                            <!-- 区块5：�?例排行（上成�?下失败，点击跳转�?-->
                                            <Border Grid.Column="4">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Top" Background="#FAFBFC" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                                                                <TextBlock Text="成功案例" Style="{StaticResource TileBlockHead}" Foreground="{StaticResource UpBrush}"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="失败案例" Style="{StaticResource TileBlockHead}" Foreground="{StaticResource DownBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8"
                                                                          PreviewMouseWheel="InnerScroll_PreviewMouseWheel">
                                                                <StackPanel>
                                                                    <ItemsControl ItemsSource="{Binding TopSuccessCases}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Padding="0,4" Cursor="Hand" Tag="{Binding}"
                                                                                        MouseLeftButtonDown="RankItem_MouseDown"
                                                                                        Background="Transparent">
                                                                                    <DockPanel>
                                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding MaxChangePctText}" FontSize="11"
                                                                                                   FontWeight="SemiBold" Foreground="{StaticResource UpBrush}"/>
                                                                                        <TextBlock Text="{Binding StockName}" FontSize="12" FontWeight="Medium"
