                            <TextBlock Grid.Row="2" Grid.Column="0" Text="日期" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <controls:ElDatePicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                        SelectedDate="{Binding AddTradeDate, Converter={StaticResource DateTimeStr}}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="最大涨幅"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AddCaseType}" Value="失败案例">
                                                <Setter Property="Text" Value="最大跌幅"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Text="%" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBox Style="{StaticResource DefaultTextBox}" Text="{Binding AddTotalReturn, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="截图" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Style="{StaticResource SmallPrimaryButton}" Content="粘贴截图" Command="{Binding PasteAddScreenshotCommand}"/>
                                    <Button Style="{StaticResource SmallDangerButton}" Content="清除" Margin="8,0,0,0"
                                            Command="{Binding ClearAddScreenshotCommand}"
                                            Visibility="{Binding AddScreenshotDisplay, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}"/>
                                </StackPanel>
                                <Border Visibility="{Binding AddScreenshotDisplay, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="180"
                                        Background="#F3F4F6" ClipToBounds="True" Margin="0,0,0,8">
                                    <Image Source="{Binding AddScreenshotDisplay, Converter={StaticResource Base64Image}}" Stretch="Uniform" MaxHeight="180"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="分析" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource DefaultTextBox}" Margin="0,0,0,8" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                                 Text="{Binding AddReflection, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{Binding AddStatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding AddStatusText, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Style="{StaticResource DefaultButton}" Margin="0,0,8,0" Command="{Binding CloseAddCaseCommand}"/>
                            <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAddCaseCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- ========== 案例对比弹窗（VS + 缩放拖拽�?========== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#CC000000" Visibility="{Binding IsCaseCompareVisible, Converter={StaticResource BoolToVis}}"
                ui:DialogOverlayBehavior.CloseOnEsc="IsCaseCompareVisible"
                MouseLeftButtonDown="CaseCompareOverlay_Click">
            <Border Style="{StaticResource DialogPanel}" Width="1100" MaxHeight="760" MouseLeftButtonDown="DialogInner_Click">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <DockPanel Margin="0,0,0,16">
                            <TextBlock Text="模式对比" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallDefaultButton}"
                                    Command="{Binding CloseCaseCompareCommand}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧案例 -->
                            <StackPanel Grid.Column="0">
                                <Border Padding="8,4" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,8"
                                        Background="{StaticResource UpLightBrush}" BorderBrush="{StaticResource UpBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding CompareLeft.CaseType}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource UpBrush}"/>
                                </Border>
                                <TextBlock Margin="0,0,0,8" Foreground="{StaticResource TextRegularBrush}">
                                    <Run Text="{Binding CompareLeft.StockName, Mode=OneWay}"/>
                                    <Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text="{Binding CompareLeft.StockCode, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                                <TextBlock Margin="0,0,0,8" Foreground="{StaticResource TextRegularBrush}">
                                    <Run Text="{Binding CompareLeft.TradeDate, Mode=OneWay}"/><Run Text=" | 收益: "/>
                                    <Run Text="{Binding CompareLeft.TotalReturnText, Mode=OneWay}" FontWeight="Bold"
                                         Foreground="{Binding CompareLeft.TotalReturn, Converter={StaticResource UpDownBrush}}"/>
                                </TextBlock>
                                <Border Height="380" Background="#F3F4F6" CornerRadius="4" ClipToBounds="True"
                                        MouseWheel="CompareImage_MouseWheel" Tag="0">
                                    <Grid>
                                        <Image x:Name="CompareImgLeft" Source="{Binding CompareLeft.DisplayScreenshot, Converter={StaticResource Base64Image}, ConverterParameter=full}"
                                               Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Cursor="SizeAll"
                                               MouseLeftButtonDown="CompareImg_MouseLeftButtonDown" MouseLeftButtonUp="CompareImg_MouseLeftButtonUp"
                                               MouseMove="CompareImg_MouseMove" MouseLeave="CompareImg_MouseLeave" Tag="0">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="LeftScale" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="LeftTranslate" X="0" Y="0"/>
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                        <TextBlock Text="无截图" Foreground="#9DA3AB" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding CompareLeft.HasScreenshot, Converter={StaticResource InverseBoolToVis}}"/>
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                                Background="#B3FFFFFF" CornerRadius="12" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="−" Style="{StaticResource ZoomCircleBtn}" Click="CompareZoomOut_Click" Tag="0"/>
                                                <TextBlock x:Name="LeftZoomText" Text="100%" FontSize="12" Width="44" TextAlignment="Center"
                                                           VerticalAlignment="Center" Foreground="{StaticResource TextRegularBrush}"/>
                                                <Button Content="＋" Style="{StaticResource ZoomCircleBtn}" Click="CompareZoomIn_Click" Tag="0"/>
                                                <Button Content="⟳" Style="{StaticResource ZoomCircleBtn}" Click="CompareZoomReset_Click" Tag="0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding CompareLeft.Reflection, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}">
                                    <Run Text="反思: " FontWeight="Bold"/><Run Text="{Binding CompareLeft.ReflectionPlain, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- VS -->
                            <Border Grid.Column="1" Background="{StaticResource TextSecondaryBrush}" Width="36" Height="36" CornerRadius="18"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85">
                                <TextBlock Text="VS" FontSize="13" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 右侧案例 -->
                            <StackPanel Grid.Column="2">
                                <Border Padding="8,4" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,8"
                                        Background="{StaticResource DownLightBrush}" BorderBrush="{StaticResource DownBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding CompareRight.CaseType}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DownBrush}"/>
                                </Border>
                                <TextBlock Margin="0,0,0,8" Foreground="{StaticResource TextRegularBrush}">
                                    <Run Text="{Binding CompareRight.StockName, Mode=OneWay}"/>
                                    <Run Text=" (" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text="{Binding CompareRight.StockCode, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <Run Text=")" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </TextBlock>
                                <TextBlock Margin="0,0,0,8" Foreground="{StaticResource TextRegularBrush}">
                                    <Run Text="{Binding CompareRight.TradeDate, Mode=OneWay}"/><Run Text=" | 收益: "/>
                                    <Run Text="{Binding CompareRight.TotalReturnText, Mode=OneWay}" FontWeight="Bold"
                                         Foreground="{Binding CompareRight.TotalReturn, Converter={StaticResource UpDownBrush}}"/>
                                </TextBlock>
                                <Border Height="380" Background="#F3F4F6" CornerRadius="4" ClipToBounds="True"
                                        MouseWheel="CompareImage_MouseWheel" Tag="1">
                                    <Grid>
                                        <Image x:Name="CompareImgRight" Source="{Binding CompareRight.DisplayScreenshot, Converter={StaticResource Base64Image}, ConverterParameter=full}"
                                               Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Cursor="SizeAll"
                                               MouseLeftButtonDown="CompareImg_MouseLeftButtonDown" MouseLeftButtonUp="CompareImg_MouseLeftButtonUp"
                                               MouseMove="CompareImg_MouseMove" MouseLeave="CompareImg_MouseLeave" Tag="1">
                                            <Image.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="RightScale" ScaleX="1" ScaleY="1"/>
                                                    <TranslateTransform x:Name="RightTranslate" X="0" Y="0"/>
                                                </TransformGroup>
                                            </Image.RenderTransform>
                                        </Image>
                                        <TextBlock Text="无截" Foreground="#9DA3AB" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding CompareRight.HasScreenshot, Converter={StaticResource InverseBoolToVis}}"/>
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                                Background="#B3FFFFFF" CornerRadius="12" Padding="8,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="−" Style="{StaticResource ZoomCircleBtn}" Click="CompareZoomOut_Click" Tag="1"/>
                                                <TextBlock x:Name="RightZoomText" Text="100%" FontSize="12" Width="44" TextAlignment="Center"
                                                           VerticalAlignment="Center" Foreground="{StaticResource TextRegularBrush}"/>
                                                <Button Content="＋" Style="{StaticResource ZoomCircleBtn}" Click="CompareZoomIn_Click" Tag="1"/>
                                                <Button Content="⟳" Style="{StaticResource ZoomCircleBtn}" Click="CompareZoomReset_Click" Tag="1"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding CompareRight.Reflection, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}">
                                    <Run Text="反思: " FontWeight="Bold"/><Run Text="{Binding CompareRight.ReflectionPlain, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- ========== 图片预�?弹窗（缩�?拖拽�?========== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#CC000000" Visibility="{Binding IsImagePreviewVisible, Converter={StaticResource BoolToVis}}"
                ui:DialogOverlayBehavior.CloseOnEsc="IsImagePreviewVisible"
                MouseLeftButtonDown="PreviewOverlay_Click">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" HorizontalAlignment="Center" Margin="16" Background="#B3FFFFFF"
                        CornerRadius="12" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="缩小 −" Style="{StaticResource SmallDefaultButton}" Click="PreviewZoomOut_Click"/>
                        <TextBlock x:Name="PreviewZoomText" Text="100%" FontSize="13" Width="56" TextAlignment="Center"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextRegularBrush}"/>
                        <Button Content="放大 ＋" Style="{StaticResource SmallDefaultButton}" Click="PreviewZoomIn_Click"/>
                        <Button Content="重置 ⟳" Style="{StaticResource SmallDefaultButton}" Margin="8,0,0,0" Click="PreviewZoomReset_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" MouseWheel="PreviewImage_MouseWheel" ClipToBounds="True">
                    <Image x:Name="PreviewImg" Source="{Binding PreviewImageUrl, Converter={StaticResource Base64Image}, ConverterParameter=full}"
                           Stretch="Uniform" RenderTransformOrigin="0.5,0.5" Cursor="SizeAll" MaxHeight="720"
                           MouseLeftButtonDown="PreviewImg_MouseLeftButtonDown" MouseLeftButtonUp="PreviewImg_MouseLeftButtonUp"
                           MouseMove="PreviewImg_MouseMove" MouseLeave="PreviewImg_MouseLeave">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
