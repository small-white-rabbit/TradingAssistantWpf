            <Rectangle Fill="#80000000" />
            <Border Style="{StaticResource DialogPanel}" Width="520" Panel.ZIndex="101">
                <StackPanel>
                    <TextBlock Text="问题标签" Style="{StaticResource SubtitleText}"/>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="名称" Style="{StaticResource Label}" Grid.Column="0"/>
                        <TextBox Style="{StaticResource DefaultTextBox}" Grid.Column="1"
                                 Text="{Binding NewProblemTagName, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="描述" Style="{StaticResource Label}" Grid.Column="0"/>
                        <TextBox Style="{StaticResource DefaultTextBox}" Grid.Column="1"
                                 Text="{Binding NewProblemTagDescription, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="排序" Style="{StaticResource Label}" Grid.Column="0"/>
                        <TextBox Style="{StaticResource DefaultTextBox}" Grid.Column="1"
                                 Text="{Binding NewProblemTagSortOrder, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="取消" Style="{StaticResource DefaultButton}" Margin="0,0,8,0"
                                Command="{Binding CancelEditCommand}"/>
                        <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveProblemTagCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
