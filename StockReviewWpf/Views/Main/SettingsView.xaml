<UserControl x:Class="StockReviewWpf.Views.Main.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- el-table 单元格：文字垂直居中（�?齐原�?el-table cell 垂直居中�?-->
        <Style x:Key="ElTableCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <TextBlock Text="设置" Style="{StaticResource TitleText}"/>

            <!-- ====== TabControl（border-card 样式�?====== -->
            <TabControl Style="{StaticResource ElTabs}">

                <!-- ====== 进场类型管理 ====== -->
                <TabItem Header="进场类型">
                    <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <StackPanel>
                            <!-- section header -->
                            <DockPanel Margin="0,0,0,8">
                                <Button Content="添加类型" Style="{StaticResource SmallPrimaryButton}" DockPanel.Dock="Right"
                                        Command="{Binding ShowAddEntryTypeDialogCommand}" HorizontalAlignment="Right"/>
                                <TextBlock Text="进场类型管理" Style="{StaticResource SubtitleText}" Margin="0"/>
                            </DockPanel>
                            <TextBlock Text="管理进场类型的分类、排序和状态" Style="{StaticResource SmallLabel}" Margin="0,0,0,12"/>

                            <!-- 不固定高度：全部行完整展示，随页面滚动（MaxHeight 兜底防超长列表撑爆） -->
                            <DataGrid ItemsSource="{Binding EntryTypes}"
                                      Style="{StaticResource ElTable}"
                                      ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                      IsReadOnly="True"
                                      MaxHeight="2000"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="排序" Binding="{Binding SortOrder}" Width="60" ElementStyle="{StaticResource ElTableCell}"/>
                                    <DataGridTemplateColumn Header="类型名称" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <!-- 父级：蓝色竖�?+ 主色加粗；子级：常�?色缩进（对齐原版 el-table 树形层级�?-->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding Indent}">
                                                    <Border Width="3" Height="14" CornerRadius="1.5" Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource PrimaryBrush}"
                                                            Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextRegularBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource ElTableCell}"/>
                                    <DataGridTemplateColumn Header="状态" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Cursor="Hand"
                                                          Command="{Binding DataContext.ToggleEntryTypeActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="操作" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="编辑" Style="{StaticResource TextButton}" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.ShowEditEntryTypeDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="删除" Style="{StaticResource TextButton}" Foreground="{StaticResource DangerBrush}"
                                                            Command="{Binding DataContext.DeleteEntryTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ====== �??标�?管理 ====== -->
                <TabItem Header="问题标签">
                    <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button Content="添加标签" Style="{StaticResource SmallPrimaryButton}" DockPanel.Dock="Right"
                                        Command="{Binding ShowAddProblemTagDialogCommand}" HorizontalAlignment="Right"/>
                                <TextBlock Text="问题标签管理" Style="{StaticResource SubtitleText}" Margin="0"/>
                            </DockPanel>
                            <TextBlock Text="管理交易复盘中使用的问题标签" Style="{StaticResource SmallLabel}" Margin="0,0,0,12"/>

                            <!-- 不固定高度：全部行完整展示，随页面滚动 -->
                            <DataGrid ItemsSource="{Binding ProblemTags}"
                                      Style="{StaticResource ElTable}"
                                      ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                      IsReadOnly="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      MaxHeight="2000">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="排序" Binding="{Binding SortOrder}" Width="60" ElementStyle="{StaticResource ElTableCell}"/>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource ElTableCell}"/>
                                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource ElTableCell}"/>
                                    <DataGridTemplateColumn Header="状态" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsActive}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Cursor="Hand"
                                                          Command="{Binding DataContext.ToggleProblemTagActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="操作" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="编辑" Style="{StaticResource TextButton}" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.ShowEditProblemTagDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="删除" Style="{StaticResource TextButton}" Foreground="{StaticResource DangerBrush}"
                                                            Command="{Binding DataContext.DeleteProblemTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ====== 归类规则 ====== -->
                <TabItem Header="归类规则">
                    <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="案例库自动归类规则" Style="{StaticResource SubtitleText}"/>
                            <TextBlock Text="设置成功/失败案例的自动归类阈值" Style="{StaticResource SmallLabel}" Margin="0,0,0,16"/>

                            <!-- 表单：label-width 150px -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="成功案例阈值" Style="{StaticResource Label}" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Style="{StaticResource DefaultTextBox}" Width="120"
                                             Text="{Binding SuccessThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="%" Style="{StaticResource Label}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="清仓后总收益 ≥ 此值自动归类为成功案例" Style="{StaticResource SmallLabel}" Margin="150,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="失败案例阈值" Style="{StaticResource Label}" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox Style="{StaticResource DefaultTextBox}" Width="120"
                                             Text="{Binding FailThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="%" Style="{StaticResource Label}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="清仓后总收益 ≤ 此值自动归类为失败案例" Style="{StaticResource SmallLabel}" Margin="150,0,0,16"/>

                            <StackPanel Orientation="Horizontal" Margin="150,0,0,0">
                                <Button Content="保存规则" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                        Command="{Binding SaveRulesCommand}"/>
                                <Button Content="重新归类全部" Style="{StaticResource DefaultButton}" Margin="0,0,8,0"
                                        Command="{Binding ReclassifyAllCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ====== 百度OCR ====== -->
                <TabItem Header="百度OCR">
                    <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="百度OCR配置" Style="{StaticResource SubtitleText}"/>
                            <Border Background="{StaticResource PrimaryLighterBrush}" BorderBrush="{StaticResource PrimaryLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,16">
                                <TextBlock Text="配置百度OCR API可以提高文字识别准确率，需要本地运行代理服务器。WPF 版默认使用内置的离线识别。" FontSize="12" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="API Key" Style="{StaticResource Label}" Grid.Column="0"/>
                                <PasswordBox x:Name="OcrApiKeyBox" Grid.Column="1" Style="{StaticResource DefaultPasswordBox}" Width="320" HorizontalAlignment="Left"
                                             PasswordChanged="OcrApiKey_PasswordChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Secret Key" Style="{StaticResource Label}" Grid.Column="0"/>
                                <PasswordBox x:Name="OcrSecretKeyBox" Grid.Column="1" Style="{StaticResource DefaultPasswordBox}" Width="320" HorizontalAlignment="Left"
                                             PasswordChanged="OcrSecretKey_PasswordChanged"/>
                            </Grid>

                            <WrapPanel Margin="150,0,0,16">
                                <Button Content="保存配置" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                        Command="{Binding SaveOcrConfigCommand}"/>
                                <Button Content="清除配置" Style="{StaticResource DefaultButton}" Margin="0,0,0,8"
                                        Command="{Binding ClearOcrConfigCommand}"/>
                            </WrapPanel>

                            <TextBlock Text="使用说明" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                                1. 访问百度智能云OCR 注册账号并创建应用；&#x0a;2. 获取 API Key 和 Secret Key；&#x0a;3. 在上方填入并保存即可使用。
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ====== 数据管理 ====== -->
                <TabItem Header="数据管理">
                    <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <StackPanel>
                            <!-- 数据存储位置 -->
                            <TextBlock Text="数据存储位置" Style="{StaticResource SubtitleText}"/>
                            <Border Background="{StaticResource PrimaryLighterBrush}" BorderBrush="{StaticResource PrimaryLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,12">
                                <TextBlock Text="数据存储位置可以自定义更改，更改后重启应用生效" FontSize="12" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="当前数据目录" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBlock Text="{Binding DataDirPath}" Grid.Column="1" FontSize="13"
                                           Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据库文件" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBlock Text="{Binding DbFilePath}" Grid.Column="1" FontSize="13"
                                           Foreground="{StaticResource TextRegularBrush}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="截图目录" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBlock Text="{Binding ImagesDirPath}" Grid.Column="1" FontSize="13"
                                           Foreground="{StaticResource TextRegularBrush}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="备份目录" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBlock Text="{Binding BackupsDirPath}" Grid.Column="1" FontSize="13"
                                           Foreground="{StaticResource TextRegularBrush}" TextWrapping="Wrap"/>
                            </Grid>
                            <Button Content="更改存储位置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding SelectDataDirCommand}"/>

                            <!-- 数据导入/导出 -->
                            <TextBlock Text="数据导入/导出" Style="{StaticResource SubtitleText}" Margin="0,24,0,8"/>
                            <TextBlock Text="数据存储在本地 SQLite 数据库中，截图以文件形式保存在 data/images 目录；应用退出时自动在备份目录生成 .db 快照（保留最近 14 份）" Style="{StaticResource SmallLabel}" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="导出备份 (ZIP)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                        Command="{Binding ExportDataCommand}"/>
                                <Button Content="导入备份 (ZIP/JSON)" Style="{StaticResource DefaultButton}" Margin="0,0,8,8"
                                        Command="{Binding ImportDataCommand}"/>
                                <Button Content="从快照恢复 (DB)" Style="{StaticResource DefaultButton}" Margin="0,0,8,8"
                                        Command="{Binding RestoreSnapshotCommand}"/>
                                <Button Content="清除全部数据" Style="{StaticResource DefaultButton}" Foreground="{StaticResource DangerBrush}"
                                        Margin="0,0,0,8" Command="{Binding ClearAllDataCommand}"/>
                            </WrapPanel>
                            <Border Background="{StaticResource SuccessLightBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                                <TextBlock Text="导入采用智能合并：已有数据按 ID 更新，新数据自动添加，不会删除现有记录。清除数据将删除所有记录，此操作不可恢复！"
                                           FontSize="12" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- ====== 云�?同�? (WebDAV) ====== -->
                            <TextBlock Text="☁️ 云端同步 (WebDAV)" Style="{StaticResource SubtitleText}" Margin="0,24,0,8"/>
                            <Border Background="{StaticResource PrimaryLighterBrush}" BorderBrush="{StaticResource PrimaryLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,12">
                                <TextBlock Text="通过 WebDAV 协议将备份数据同步到云端服务器，支持坚果云、NextCloud、群晖等"
                                           FontSize="12" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap"/>
                            </Border>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="服务器地址" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBox Style="{StaticResource DefaultTextBox}" Grid.Column="1" Width="420" HorizontalAlignment="Left"
                                         Text="{Binding WebDavServerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="用户名" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBox Style="{StaticResource DefaultTextBox}" Grid.Column="1" Width="420" HorizontalAlignment="Left"
                                         Text="{Binding WebDavUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="密码" Style="{StaticResource Label}" Grid.Column="0"/>
                                <PasswordBox x:Name="WebDavPasswordBox" Grid.Column="1" Style="{StaticResource DefaultPasswordBox}"
                                             Width="420" HorizontalAlignment="Left" PasswordChanged="WebDavPassword_PasswordChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="远程路径" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBox Style="{StaticResource DefaultTextBox}" Grid.Column="1" Width="420" HorizontalAlignment="Left"
                                         Text="{Binding WebDavRemotePath, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <WrapPanel Margin="150,0,0,0">
                                <Button Content="保存配置" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                        Command="{Binding SaveWebDavConfigCommand}"/>
                                <Button Content="测试连接" Style="{StaticResource DefaultButton}" Margin="0,0,0,8"
                                        Command="{Binding TestWebDavConnectionCommand}"/>
                            </WrapPanel>
                            <WrapPanel Margin="150,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"
                                        Command="{Binding CloudUploadCommand}" Content="{Binding CloudUploadButtonText}"/>
                                <Button Content="从云端恢复" Style="{StaticResource DefaultButton}" Margin="0,0,8,8"
                                        Command="{Binding CloudRestoreLatestCommand}"/>
                                <Button Content="刷新云端文件列表" Style="{StaticResource DefaultButton}" Margin="0,0,0,8"
                                        Command="{Binding RefreshCloudFilesCommand}"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="150,10,0,0">
                                <CheckBox IsChecked="{Binding AutoSyncEnabled}" VerticalAlignment="Center"/>
                                <TextBlock Text="启用自动同步（每次关闭应用时自动上传备份）" FontSize="12" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 云�?备份文件列表 -->
                            <TextBlock Text="云端备份文件" Style="{StaticResource SubtitleText}" Margin="0,20,0,8"/>
                            <DataGrid ItemsSource="{Binding CloudFiles}"
                                      Style="{StaticResource ElTable}"
                                      ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                      IsReadOnly="True" MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="文件名" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100"/>
                                    <DataGridTextColumn Header="修改时间" Binding="{Binding LastModified}" Width="180"/>
                                    <DataGridTemplateColumn Header="操作" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="恢复" Style="{StaticResource TextButton}" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.CloudRestoreFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}"/>
                                                    <Button Content="删除" Style="{StaticResource TextButton}" Foreground="{StaticResource DangerBrush}"
                                                            Command="{Binding DataContext.CloudDeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Name}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 同�?状�?�提�?-->
                            <TextBlock Text="{Binding CloudMessage}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding CloudMessage, Converter={StaticResource StringNotEqualsToVis}, ConverterParameter=''}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CloudMessageIsError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- �?��存储管理 -->
                            <TextBlock Text="截图存储管理" Style="{StaticResource SubtitleText}" Margin="0,24,0,8"/>
                            <TextBlock Text="截图已存储为本地文件，数据库仅保存文件路径，大幅节省存储空间" Style="{StaticResource SmallLabel}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="占用统计" Style="{StaticResource Label}" Grid.Column="0"/>
                                <TextBlock Text="{Binding ScreenshotStatsText}" Grid.Column="1" FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="清理未引用截图" Style="{StaticResource DefaultButton}" Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"
                                        Command="{Binding CleanupOrphanedScreenshotsCommand}"/>
                                <Button Content="刷新统计" Style="{StaticResource DefaultButton}"
                                        Command="{Binding RefreshScreenshotStatsCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DataManageFeedback}" FontSize="12" Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding DataManageFeedback, Converter={StaticResource StringNotEqualsToVis}, ConverterParameter=''}"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- ====== 桌面宠物 ====== -->
                <TabItem Header="桌面宠物">
                    <Border Style="{StaticResource CardPanel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="🐂 桌面宠物设置" Style="{StaticResource SubtitleText}"/>
                            <Border Background="{StaticResource PrimaryLighterBrush}" BorderBrush="{StaticResource PrimaryLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8,0,20">
                                <TextBlock Text="桌面宠物可以在桌面独立运行，实时监控您的交易计划和股票行情" FontSize="12" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- 宠物�?�?+ 运�?状�?�（对齐原版 pet-control-section�?-->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button MinWidth="140" Command="{Binding TogglePetCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value=""/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PetRunning}" Value="True">
                                                    <Setter Property="Content" Value="关闭宠物"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Margin="12,6,0,0" FontSize="13" VerticalAlignment="Center" Text="○ 宠物已关闭">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
