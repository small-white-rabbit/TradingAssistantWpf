<UserControl x:Class="StockReviewWpf.Views.Main.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:conv="clr-namespace:StockReviewWpf.Converters"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- 总�?卡片模板（�?��?/强股分析/�??分析 三�?共用�?-->
        <DataTemplate x:Key="OverviewCardTemplate">
            <Border Style="{StaticResource OverviewCard}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- �??�卡 -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center"
                                Visibility="{Binding IsRanking, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Value}" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClassName}" Value="up">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ClassName}" Value="down">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- 排名�?-->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                Visibility="{Binding IsRanking, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Ranking}" MaxHeight="64">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Rate, StringFormat='{}{0}%'}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                        <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource TextRegularBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <!-- ====== filter-bar：白色卡片条（月�?+ 年度 + 重置�?====== -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,16"
                    BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="1">
                <DockPanel>
                    <Button Content="重置筛选" Style="{StaticResource SmallDefaultButton}" DockPanel.Dock="Right"
                            Command="{Binding ResetFilterCommand}" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 月份选择（下拉，原版 el-date-picker type=month�?-->
                        <TextBlock Text="月份:" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                        <ComboBox Style="{StaticResource DefaultComboBox}"
                                  Width="140" Margin="0,0,16,0"
                                  ItemsSource="{Binding AvailableMonths}"
                                  SelectedItem="{Binding SelectedMonth}"/>
                        <!-- 年度选择（仅 yearly tab �??�?-->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsYearlyFilterVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="年度:" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                            <ComboBox Style="{StaticResource DefaultComboBox}"
                                      Width="120" Margin="0,0,16,0"
                                      ItemsSource="{Binding AvailableYears}"
                                      SelectedItem="{Binding SelectedYear}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ====== OverviewCards�?�?行，�?00px ====== -->
            <ItemsControl ItemsSource="{Binding OverviewCards}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="6" Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource OverviewCard}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- �??�卡 -->
                                <StackPanel Grid.Row="0" VerticalAlignment="Center"
                                            Visibility="{Binding IsRanking, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Text="{Binding Value}" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClassName}" Value="up">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ClassName}" Value="down">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <!-- 排名�?-->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                            Visibility="{Binding IsRanking, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatLabel}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding Ranking}" MaxHeight="64">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,2">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Rate, StringFormat='{}{0}%'}"
                                                               FontSize="11" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                                    <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource TextRegularBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ====== TabControl：按分析维度分页（SelectionChanged 同�? ActiveTab 以驱动图表懒渲染�?====== -->
            <TabControl Style="{StaticResource ElTabs}" Margin="0,0,0,0" SelectionChanged="Tabs_SelectionChanged">

                <!-- 月度分析 -->
                <TabItem Header="月度分析">
                    <StackPanel Margin="0,12,0,0">
                        <!-- chart-section -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="各类型胜率" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="EntryTypeChart" Height="300"/>
                            </StackPanel>
                        </Border>
                        <!-- 双卡行：EntryTypeTable + ProblemTable -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="当月进场类型统计" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding MonthEntryTypeData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="进场类型" Binding="{Binding EntryType}" Width="*"/>
                                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="胜率" Binding="{Binding WinRate}" Width="60"/>
                                            <DataGridTextColumn Header="平均收益" Binding="{Binding AvgReturn}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="当月问题统计" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding MonthProblemData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="问题分析" Binding="{Binding Problem}" Width="*"/>
                                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="占比" Binding="{Binding Percentage}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- �?�?��对比 -->
                <TabItem Header="各类型胜率对比">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="各类型胜率趋势" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="Last6WinRateChart" Height="300"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="综合胜率" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="Last6OverallChart" Height="250"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="收益趋势" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="Last6ReturnChart" Height="250"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="进场类型统计（近6个月）" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding Last6EntryTypeData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="进场类型" Binding="{Binding EntryType}" Width="*"/>
                                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="胜率" Binding="{Binding WinRate}" Width="60"/>
                                            <DataGridTextColumn Header="平均收益" Binding="{Binding AvgReturn}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="问题统计（近6个月）" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding Last6ProblemData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="问题类型" Binding="{Binding Problem}" Width="*"/>
                                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="占比" Binding="{Binding Percentage}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- �?�?2�?�� -->
                <TabItem Header="近6个月对比">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="胜率趋势对比" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="Last12WinRateChart" Height="300"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="综合胜率" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="Last12OverallChart" Height="250"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="收益趋势" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="Last12ReturnChart" Height="250"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="进场类型统计（近12个月）" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding Last12EntryTypeData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="进场类型" Binding="{Binding EntryType}" Width="*"/>
                                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="胜率" Binding="{Binding WinRate}" Width="60"/>
                                            <DataGridTextColumn Header="平均收益" Binding="{Binding AvgReturn}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="问题统计（近12个月）" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding Last12ProblemData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="问题类型" Binding="{Binding Problem}" Width="*"/>
                                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="占比" Binding="{Binding Percentage}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- 年度 -->
                <TabItem Header="年度">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="年度各类型胜率趋势对比" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="YearlyWinRateChart" Height="300"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="综合胜率" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="YearlyOverallChart" Height="250"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="收益趋势" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="YearlyReturnChart" Height="250"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="进场类型统计" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding YearlyEntryTypeData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="进场类型" Binding="{Binding EntryType}" Width="*"/>
                                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="胜率" Binding="{Binding WinRate}" Width="60"/>
                                            <DataGridTextColumn Header="平均收益" Binding="{Binding AvgReturn}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="问题统计" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding YearlyProblemData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="问题类型" Binding="{Binding Problem}" Width="*"/>
                                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="占比" Binding="{Binding Percentage}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- 总�? -->
                <TabItem Header="总览">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="全部数据各类型胜率统计" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="AllWinRateChart" Height="300"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="综合胜率" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="AllOverallChart" Height="250"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="全部数据收益分布" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="AllReturnChart" Height="250"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="全部进场类型统计" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding AllEntryTypeData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="进场类型" Binding="{Binding EntryType}" Width="*"/>
                                            <DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="胜率" Binding="{Binding WinRate}" Width="60"/>
                                            <DataGridTextColumn Header="平均收益" Binding="{Binding AvgReturn}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="全部问题汇总" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding AllProblemData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="问题类型" Binding="{Binding Problem}" Width="*"/>
                                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="60"/>
                                            <DataGridTextColumn Header="占比" Binding="{Binding Percentage}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- 强股分析 -->
                <TabItem Header="强股分析">
                    <StackPanel Margin="0,12,0,0">
                        <!-- 顶部总�?卡片（�?�?Vue strongOverviewCards�?-->
                        <ItemsControl ItemsSource="{Binding StrongOverviewCards}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="OverviewCardTemplate"/>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="强股月度趋势" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="StrongMonthlyChart" Height="300"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="强势类型分布" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="StrongTypeChart" Height="300"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="年度强股统计" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding StrongYearData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="年份" Binding="{Binding Year}" Width="*"/>
                                            <DataGridTextColumn Header="强股数量" Binding="{Binding Count}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="月度强股统计" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding StrongMonthData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="月份" Binding="{Binding Month}" Width="*"/>
                                            <DataGridTextColumn Header="强股数量" Binding="{Binding Count}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- �??分析 -->
                <TabItem Header="问题分析">
                    <StackPanel Margin="0,12,0,0">
                        <!-- 顶部总览卡片（对应 Vue problemOverviewCards） -->
                        <ItemsControl ItemsSource="{Binding ProblemOverviewCards}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="OverviewCardTemplate"/>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="问题类型分布" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="ProblemChart" Height="300"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="进场类型与问题关联分析" Style="{StaticResource SubtitleText}"/>
                                <scottPlot:WpfPlot x:Name="EntryTypeProblemChart" Height="300"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="问题频率排行" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding ProblemFrequencyData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="问题类型" Binding="{Binding Problem}" Width="*"/>
                                            <DataGridTextColumn Header="出现次数" Binding="{Binding Count}" Width="80"/>
                                            <DataGridTextColumn Header="占比" Binding="{Binding Percentage}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="进场类型常见问题" Style="{StaticResource SubtitleText}"/>
                                    <DataGrid ItemsSource="{Binding EntryTypeProblemData}"
                                              Style="{StaticResource ElTable}"
                                              ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                              IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="进场类型" Binding="{Binding EntryType}" Width="*"/>
                                            <DataGridTextColumn Header="最常见问题" Binding="{Binding CommonProblem}" Width="*"/>
                                            <DataGridTextColumn Header="次数" Binding="{Binding Count}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </TabItem>

                <!-- 数据表格 -->
                <TabItem Header="数据表格">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="月度明细" Style="{StaticResource SubtitleText}"/>
                                <DataGrid ItemsSource="{Binding TableData}"
                                          Style="{StaticResource ElTable}"
                                          ColumnHeaderStyle="{StaticResource ElTableHeader}"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="月份" Binding="{Binding Month}" Width="*"/>
                                        <DataGridTextColumn Header="总笔数" Binding="{Binding Total}" Width="80"/>
                                        <DataGridTextColumn Header="胜率" Binding="{Binding WinRate}" Width="80"/>
                                        <DataGridTextColumn Header="平均收益" Binding="{Binding AvgReturn}" Width="100"/>
                                        <DataGridTextColumn Header="最佳单月" Binding="{Binding Best}" Width="100"/>
                                        <DataGridTextColumn Header="1" Binding="{Binding Worst}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
