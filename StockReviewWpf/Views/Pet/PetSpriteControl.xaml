<UserControl x:Class="StockReviewWpf.Views.Pet.PetSpriteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             Focusable="False">
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- 精灵图：每帧是预裁剪的小位图，直接换 Source（避免整张图集平移重绘导致分层窗口闪烁） -->
        <Image x:Name="SpriteImage" Stretch="Fill"/>

        <!-- 休息中：ZZZ 浮动符号（对应 PetSpriteBody.vue 的 zzz-overlay） -->
        <Canvas x:Name="ZzzCanvas"
                Visibility="Collapsed"
                IsHitTestVisible="False"
                Width="40" Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,4,12,0">
            <TextBlock x:Name="Zzz1" Text="z" FontSize="10" FontWeight="Bold"
                       Foreground="#7aa7ff" Opacity="0"
                       Canvas.Left="0" Canvas.Top="20"/>
            <TextBlock x:Name="Zzz2" Text="Z" FontSize="13" FontWeight="Bold"
                       Foreground="#7aa7ff" Opacity="0"
                       Canvas.Left="8" Canvas.Top="14"/>
            <TextBlock x:Name="Zzz3" Text="Z" FontSize="16" FontWeight="Bold"
                       Foreground="#7aa7ff" Opacity="0"
                       Canvas.Left="16" Canvas.Top="6"/>
        </Canvas>
    </Grid>
</UserControl>
