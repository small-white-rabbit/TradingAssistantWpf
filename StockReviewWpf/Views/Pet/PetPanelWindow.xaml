<Window x:Class="StockReviewWpf.Views.Pet.PetPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面宠物 - 面板"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SizeToContent="WidthAndHeight"
        MaxHeight="880"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Fluent 浮层：8px 圆角 + 柔和弥散阴影（浮窗需要与桌面分离的高度暗示） -->
    <Border Background="{StaticResource BgPageBrush}" BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1" CornerRadius="8" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.16"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动）：表面色 + 底部发丝线（Fluent 对话框样式，替代整块灰底）。
                 分时图弹窗隐藏此栏（面板自带标题头承担标题/关闭/拖动） -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource BgPageBrush}" CornerRadius="8,8,0,0"
                    BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="0,0,0,1"
                    Padding="18,10,8,10"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="PanelTitleText" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Style="{StaticResource CaptionCloseBtn}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 面板内容区 -->
            <ContentControl x:Name="PanelContent" Grid.Row="1" Focusable="False"/>
        </Grid>
    </Border>
</Window>
