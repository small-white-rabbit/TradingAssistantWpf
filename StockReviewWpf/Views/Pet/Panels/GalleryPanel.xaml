<UserControl x:Class="StockReviewWpf.Views.Pet.Panels.GalleryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="GalleryActionBtn" TargetType="Button" BasedOn="{StaticResource SmallDefaultButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="48"/>
        </Style>

        <!-- el-radio-button 分�?按钮（组合进外层 Border，中间竖线分隔） -->
        <Style x:Key="SegRadioBtn" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextRegularBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="White" Padding="14,5" CornerRadius="3">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar (对齐原版 gallery-toolbar：radio-group + 搜索 + 刷新 �?�? -->
        <Border DockPanel.Dock="Top" Padding="20,8,20,8">
            <StackPanel Orientation="Horizontal">
                <!-- el-radio-button 分�?：全�?(N) | 已安�?(M) -->
                <Border BorderBrush="{StaticResource BorderBaseBrush}" BorderThickness="1" CornerRadius="4" Background="White">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="GalleryFilter" IsChecked="True" Style="{StaticResource SegRadioBtn}"
                                     Command="{Binding FilterAllCommand}">
                            <TextBlock FontSize="12">
                                <Run Text="全部 "/><Run Text="{Binding TotalCount}" FontWeight="Bold"/>
                            </TextBlock>
                        </RadioButton>
                        <Rectangle Width="1" Fill="{StaticResource BorderBaseBrush}"/>
                        <RadioButton GroupName="GalleryFilter" Style="{StaticResource SegRadioBtn}"
                                     Command="{Binding FilterInstalledCommand}">
                            <TextBlock FontSize="12">
                                <Run Text="已安装 "/><Run Text="{Binding InstalledCount}" FontWeight="Bold"/>
                            </TextBlock>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <TextBox Width="200" Style="{StaticResource DefaultTextBox}" Margin="12,0,0,0"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索名称 / 作者"/>
                <Button Content="刷新目录" Style="{StaticResource SmallDefaultButton}" Margin="12,0,0,0"
                        FontSize="12" Padding="12,5" Command="{Binding RefreshCatalogCommand}"/>
            </StackPanel>
        </Border>

        <!-- Status message -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource PrimaryBrush}"
                   Margin="20,0,20,4" Visibility="{Binding StatusMessage, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}"/>

        <!-- Footer（�?齐原�?dialog-footer：当前�?�?+ 切回默�? 右�?齐，统�?居左�?-->
        <Border DockPanel.Dock="Bottom" Padding="20,8" Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                    <Run Text="已安装 "/>
                    <Run Text="{Binding InstalledCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Run Text=" / 目录 "/>
                    <Run Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Run Text=" "/>
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextRegularBrush}" Margin="0,0,12,0">
                        <Run Text="当前外观："/>
                        <Run Text="{Binding ActivePetName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </TextBlock>
                    <Button Content="切回默认" Style="{StaticResource SmallDefaultButton}"
                            FontSize="12" Padding="10,4" Foreground="{StaticResource WarningBrush}"
                            Command="{Binding DeactivateCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Pet card grid (3�? 对齐原版 grid-template-columns: repeat(3, 1fr)) -->
        <!-- 滚动条为占位式（ThinScrollBar）：�?�� 6px 贴右边�?�?��空间，卡片不会�?�?�� -->
        <!-- 接近底部时触发缩略图懒加载扩批（每�? +30�?-->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="20,0,2,4" ScrollChanged="OnGalleryScrollChanged">
            <Grid>
            <ItemsControl ItemsSource="{Binding CatalogItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="0" Margin="4" Background="White">
                            <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="-4"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <!-- Thumbnail placeholder (130px, 对齐原版 pet-thumb-wrap) -->
                                <Border Height="130" Background="{StaticResource BgBrush}" CornerRadius="7,7,0,0">
                                    <Grid>
                                        <!-- 精灵缩略图（首帧 192:208，按高度缩放完整显示�?-->
                                        <Image Source="{Binding ThumbnailPath}" Stretch="Uniform"
                                               Height="120" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                        <!-- Version badge -->
                                        <Border CornerRadius="3" Padding="4,1" HorizontalAlignment="Right"
                                                VerticalAlignment="Top" Margin="0,4,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Version}" Value="2">
                                                            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Version}" Value="3">
                                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9" FontWeight="Bold" Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="V1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Version}" Value="2">
                                                                <Setter Property="Text" Value="V2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Version}" Value="3">
                                                                <Setter Property="Text" Value="V3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <!-- Active badge -->
                                        <Border CornerRadius="3" Padding="4,1" HorizontalAlignment="Left"
                                                VerticalAlignment="Top" Margin="4,4,0,0"
                                                Background="{StaticResource SuccessBrush}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="使用中" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Info (对齐原版 pet-info) -->
                                <StackPanel Margin="10,8,10,4">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Author}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Actions (对齐原版 pet-actions)：未安装 → "安装"（可点击安装），已安装 → "已安装"（禁用） -->
                                <StackPanel Orientation="Horizontal" Margin="10,0,10,10">
                                    <Button Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GalleryActionBtn}">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Content" Value="安装"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Setter Property="Content" Value="已安装"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource GalleryActionBtn}" Content="使用"
                                            Background="{StaticResource SuccessBrush}" Foreground="White"
                                            Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                    <Button Style="{StaticResource GalleryActionBtn}" Content="卸载"
                                            Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 空状态（对齐 PlanListPanel / CustomReminderPanel�?-->
            <Border Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,60">
                <StackPanel>
                    <TextBlock Text="🐾" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="暂无可用宠物" FontSize="16" Foreground="{StaticResource TextRegularBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock Text="点击「刷新目录」从在线获取" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>