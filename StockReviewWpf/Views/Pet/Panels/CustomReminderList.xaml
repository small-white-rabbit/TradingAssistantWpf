<UserControl x:Class="StockReviewWpf.Views.Pet.Panels.CustomReminderList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgBrush}" Padding="16,10">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextRegularBrush}">
                    <Run Text="自定义提醒 ("/>
                    <Run Text="{Binding EnabledCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Run Text="/"/>
                    <Run Text="{Binding TotalCount}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Run Text=")"/>
                </TextBlock>
                <Button Content="+ 添加提醒" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Command="{Binding ShowAddDialogCommand}"/>
            </DockPanel>
        </Border>

        <!-- Reminder list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,8,16,16">
            <ItemsControl ItemsSource="{Binding Reminders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <DockPanel>
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right"
                                                Background="{StaticResource InfoLightBrush}">
                                            <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                                        <Run Text="{Binding Time}"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Content}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <CheckBox Style="{StaticResource DefaultCheckBox}" IsChecked="{Binding Enabled}" Content="启用" Margin="0,0,8,0"
                                              Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"/>
                                    <Button Content="编辑" Style="{StaticResource SmallDefaultButton}" Margin="0,0,4,0"
                                            Command="{Binding DataContext.ShowEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="删除" Style="{StaticResource DangerButton}" Padding="10,4" FontSize="11" MinHeight="28"
                                            Command="{Binding DataContext.DeleteReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>