<UserControl x:Class="StockReviewWpf.Views.Pet.Panels.ReminderHistoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:StockReviewWpf.ViewModels"
             xmlns:petvm="clr-namespace:StockReviewWpf.ViewModels.Pet"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- Stats cards (对齐原版 stats-row: 总提�?今日/已响�?�?���?�?Fluent �?��浅底，去渐变) -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="20,12,20,0">
            <Border Style="{StaticResource StatCard}" Margin="0,0,6,0"
                    Background="{StaticResource PrimaryLightBrush}" BorderBrush="{StaticResource BorderLightBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="总提醒" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,6,0"
                    Background="{StaticResource SuccessLightBrush}" BorderBrush="{StaticResource SuccessBorderBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding TodayCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="今日" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,6,0"
                    Background="{StaticResource WarningLightBrush}" BorderBrush="{StaticResource WarningBorderBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding RespondedCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="已响应" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}"
                    Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBorderBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding UnrespondedCount}" Style="{StaticResource StatValue}" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="未响应" Style="{StaticResource StatLabel}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filter bar (对齐原版 filter-bar) -->
        <Border DockPanel.Dock="Top" Padding="20,10,20,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <ComboBox Style="{StaticResource DefaultComboBox}" Width="110" Margin="0,0,8,0"
                              SelectedValue="{Binding FilterType}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="全部类型" Tag="all"/>
                        <ComboBoxItem Content="价格提醒" Tag="price_alert"/>
                        <ComboBoxItem Content="止损提醒" Tag="stop_loss"/>
                        <ComboBoxItem Content="目标价提醒" Tag="target_price"/>
                        <ComboBoxItem Content="涨跌停提醒" Tag="limit_move"/>
                        <ComboBoxItem Content="卖点信号" Tag="sell_point"/>
                        <ComboBoxItem Content="信号提醒" Tag="signal"/>
                        <ComboBoxItem Content="心得提醒" Tag="insight"/>
                        <ComboBoxItem Content="交易提醒" Tag="trade"/>
                        <ComboBoxItem Content="收盘提醒" Tag="after_market"/>
                        <ComboBoxItem Content="盘后复盘" Tag="after_market_review"/>
                        <ComboBoxItem Content="休市摘要" Tag="market_digest"/>
                        <ComboBoxItem Content="自定义提醒" Tag="custom_reminder"/>
                        <ComboBoxItem Content="快速拉升" Tag="surge"/>
                        <ComboBoxItem Content="快速下跌" Tag="plunge"/>
                    </ComboBox>
                    <ComboBox Style="{StaticResource DefaultComboBox}" Width="100" Margin="0,0,8,0"
                              SelectedValue="{Binding FilterLevel}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="全部级别" Tag="all"/>
                        <ComboBoxItem Content="提示" Tag="hint"/>
                        <ComboBoxItem Content="警告" Tag="alert"/>
                        <ComboBoxItem Content="警戒" Tag="warning"/>
                        <ComboBoxItem Content="严重" Tag="critical"/>
                        <ComboBoxItem Content="强制" Tag="force"/>
                    </ComboBox>
                    <ComboBox Style="{StaticResource DefaultComboBox}" Width="100" Margin="0,0,8,0"
                              SelectedValue="{Binding FilterResponse}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="全部响应" Tag="all"/>
                        <ComboBoxItem Content="已响应" Tag="responded"/>
                        <ComboBoxItem Content="未响应" Tag="unresponded"/>
                    </ComboBox>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                        <Run Text=" 条结果"/>
                    </TextBlock>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="清空历史" FontSize="12" Padding="8,3"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{StaticResource DangerBrush}"
                        Command="{Binding ClearHistoryCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </Border>

        <!-- Retention hint (dock Bottom 必须�?Fill 之前) -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource WarningLightBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8" Margin="20,0,20,12">
            <TextBlock Text="提醒历史保留最近 3 天，超过时间的记录将自动清除"
                       FontSize="12" Foreground="{StaticResource WarningBrush}" TextAlignment="Center"/>
        </Border>

        <!-- Records list (Fill 占满剩余空间，�?齐原�?history-list) -->
        <Grid Margin="20,0,20,12">
            <ListBox ItemsSource="{Binding FlatRecords}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type petvm:ReminderDateHeader}">
                        <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,2" Padding="0,6,0,6" Margin="0,16,0,6">
                            <DockPanel>
                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{Binding DateLabel}"/>
                                <Border DockPanel.Dock="Right" Background="{StaticResource BgBrush}" CornerRadius="10" Padding="8,2">
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding RecordCount, Mode=OneWay}"/>
                                        <Run Text=" 条"/>
                                    </TextBlock>
                                </Border>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ReminderHistoryRecord}">
                                            <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="10"
                                                    Padding="12,10" Margin="0,0,0,8" Background="White">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 左色�?(border-left: 4px solid) -->
                                                    <Border Grid.Column="0" CornerRadius="2,0,0,2"
                                                            Background="{StaticResource PrimaryBrush}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="alert">
                                                                        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="warning">
                                                                        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="critical">
                                                                        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="force">
                                                                        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <!-- Header: tags + time -->
                                                        <DockPanel Margin="0,0,0,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border CornerRadius="3" Padding="6,1" Margin="0,0,4,0">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Level}" Value="alert">
                                                                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="warning">
                                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="critical">
                                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Level}" Value="force">
                                                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="10" Foreground="White" Text="{Binding LevelLabel}"/>
                                                                </Border>
                                                                <Border CornerRadius="3" Padding="6,1" Background="{StaticResource BgBrush}" Margin="0,0,4,0">
                                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="10" Foreground="{StaticResource TextRegularBrush}"/>
                                                                </Border>
                                                                <Border CornerRadius="3" Padding="6,1" Background="{StaticResource WarningLightBrush}"
                                                                        Visibility="{Binding StockCode, Converter={StaticResource NotNullToVis}, ConverterParameter=notEmpty}">
                                                                    <TextBlock FontSize="10" Foreground="{StaticResource WarningBrush}">
                                                                        <Run Text="{Binding StockName, Mode=OneWay}"/>
                                                                        <Run Text=" "/>
                                                                        <Run Text="{Binding StockCode, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeFormatted}" FontSize="12"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Content}" FontSize="13" Foreground="{StaticResource TextRegularBrush}"
                                                                   TextWrapping="Wrap" LineHeight="20"/>
                                                        <Border BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="0,1,0,0"
                                                                Padding="0,6,0,0" Margin="0,6,0,0"
                                                                Visibility="{Binding UserResponse, Converter={StaticResource NotNullToVis}}">
                                                            <DockPanel>
                                                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                                    <Run Text="响应: " Foreground="{StaticResource TextPlaceholderBrush}"/>
                                                                    <Run Text="{Binding ResponseLabel, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium"/>
                                                                </TextBlock>
                                                                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                                           Visibility="{Binding ResponseTime, Converter={StaticResource NotNullToVis}}">
                                                                    <Run Text="("/>
                                                                    <Run Text="{Binding ResponseTime, Mode=OneWay}"/>
                                                                    <Run Text="秒)"/>
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                </ListBox.Resources>
            </ListBox>
                <!-- Empty state -->
                <Border x:Name="EmptyState" Padding="40,40,40,20" HorizontalAlignment="Center"
                        Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无提醒记录" FontSize="16" Foreground="{StaticResource TextRegularBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="触发的提醒会自动记录到此处，保留最近 3 天" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
        </Grid>
    </DockPanel>
</UserControl>