<UserControl x:Class="StockReviewWpf.Views.Pet.Panels.CustomReminderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StockReviewWpf.Views.Pet.Controls"
             Background="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="TableHeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,4"/>
        </Style>
        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextRegularBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- 表格�?hover 效果（�?�?el-table row-hover�?-->
        <Style x:Key="TableRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionIconBtn" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ====== 主列表�?�?====== -->
        <DockPanel>
            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Padding="16,12,16,8">
                <DockPanel>
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextRegularBrush}">
                        <Run Text="共 "/>
                        <Run Text="{Binding TotalCount}" FontWeight="Bold"/>
                        <Run Text=" 条提醒（启用 "/>
                        <Run Text="{Binding EnabledCount}" FontWeight="Bold"/>
                        <Run Text=" 条）"/>
                    </TextBlock>
                    <Button Content="+ 添加提醒" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"
                            HorizontalAlignment="Right" Click="AddReminder_Click"/>
                </DockPanel>
            </Border>

            <!-- 表头 -->
            <Border DockPanel.Dock="Top" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="0,0,0,1"
                    Margin="16,0,16,0"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Grid MinHeight="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="标题" Style="{StaticResource TableHeaderCell}"/>
                    <TextBlock Grid.Column="1" Text="类型" Style="{StaticResource TableHeaderCell}"/>
                    <TextBlock Grid.Column="2" Text="触发时间" Style="{StaticResource TableHeaderCell}"/>
                    <TextBlock Grid.Column="3" Text="状态" Style="{StaticResource TableHeaderCell}"/>
                    <TextBlock Grid.Column="4" Text="启用" Style="{StaticResource TableHeaderCell}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="操作" Style="{StaticResource TableHeaderCell}"/>
                </Grid>
            </Border>

            <!-- 列表 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320" Margin="16,0,16,12">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Reminders}"
                                  Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TableRow}" BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="0,0,0,1" Padding="0" Background="White">
                                    <Grid MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding Title, TargetNullValue='(未命名)'}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="{Binding Content}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                CornerRadius="3" Padding="6,1"
                                                Background="{Binding TypeTagBg}" BorderBrush="{Binding TypeTagBorder}" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="{Binding TypeTagFg}" Text="{Binding TypeLabel}"/>
                                        </Border>

                                        <!-- 触发时间两行：第一行日期/星期，第二行时间(· 股票名) -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding TriggerScheduleText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextRegularBrush}"
                                                       Text="{Binding TriggerClockText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                CornerRadius="3" Padding="6,1"
                                                Background="{Binding StatusTagBg}"
                                                BorderBrush="{Binding StatusTagBorder}" BorderThickness="1">
                                            <TextBlock FontSize="11" Foreground="{Binding StatusTagFg}" Text="{Binding StatusLabel}"/>
                                        </Border>

                                        <CheckBox Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  IsChecked="{Binding Enabled}" Click="ToggleEnabled_Click" Tag="{Binding}"/>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ActionIconBtn}" ToolTip="编辑"
                                                    Click="EditReminder_Click" Tag="{Binding}">
                                                <Path Data="M11,4 L4,4 A2,2 0 0 0 2,6 L2,20 A2,2 0 0 0 4,22 L18,22 A2,2 0 0 0 20,20 L20,13 M18.5,2.5 A2.121,2.121 0 0 1 21.5,5.5 L12,15 L8,16 L9,12 Z"
                                                      Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2.5" Fill="Transparent"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Fill"/>
                                            </Button>
                                            <Button Style="{StaticResource ActionIconBtn}" ToolTip="删除"
                                                    Click="DeleteReminder_Click" Tag="{Binding}">
                                                <Path Data="M3,6 L5,6 L21,6 M19,6 L19,20 A2,2 0 0 1 17,22 L7,22 A2,2 0 0 1 5,20 L5,6 M8,6 L8,4 A2,2 0 0 1 10,2 L14,2 A2,2 0 0 1 16,4 L16,6"
                                                      Stroke="{StaticResource DangerBrush}" StrokeThickness="2" Fill="Transparent"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="13" Height="13" Stretch="Fill"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding PlaceholderItems}"
                                  Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderExtraLightBrush}" BorderThickness="0,0,0,1" Background="White">
                                    <Grid Height="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="150"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状�?-->
                    <Border Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}"
                            Padding="40,50,40,20" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="暂无自定义提醒" FontSize="16" Foreground="{StaticResource TextRegularBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="点击右上角「+ 添加提醒」开始使用" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- ====== 编辑弹窗�?�� ====== -->
        <Border x:Name="DialogOverlay" Background="#80000000" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="520" Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <DockPanel>
                    <!-- 底部按钮 -->
                    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Style="{StaticResource DefaultButton}" Margin="0,0,12,0"
                                    Click="CloseDialog_Click"/>
                            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="SaveReminder_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 表单 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
                        <StackPanel Margin="20,0,20,12">
                            <!-- 表单头部 -->
                            <Border BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="0,0,0,1" Margin="0,16,0,12" Padding="0,0,0,10">
                                <TextBlock x:Name="DialogTitle" Text="添加提醒" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>

                            <!-- 标�? -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标题" FontSize="13" Foreground="{StaticResource TextRegularBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" x:Name="TitleBox" MinHeight="32" MaxLength="40"
                                         Style="{StaticResource DefaultTextBox}"/>
                            </Grid>

                            <!-- 提醒类型 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="提醒类型" FontSize="13" Foreground="{StaticResource TextRegularBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton x:Name="TypeOnce" Content="一次性" IsChecked="True" Margin="0,0,16,0"
                                                 Checked="Type_Changed"/>
                                    <RadioButton x:Name="TypeDaily" Content="每日重复" Margin="0,0,16,0"
                                                 Checked="Type_Changed"/>
                                    <RadioButton x:Name="TypeWeekly" Content="每周重复" Checked="Type_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- 日期 -->
                            <Grid x:Name="DatePanel" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="日期" FontSize="13" Foreground="{StaticResource TextRegularBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <controls:ElDatePicker Grid.Column="1" x:Name="DatePicker" MinHeight="32" Width="200"
                                            HorizontalAlignment="Left"/>
                            </Grid>

                            <!-- 时间 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="时间" FontSize="13" Foreground="{StaticResource TextRegularBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ComboBox x:Name="HourBox" Width="64" MinHeight="32" Margin="0,0,4,0" Style="{StaticResource DefaultComboBox}"/>
                                    <TextBlock Text=":" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                               Margin="0,0,4,0"/>
                                    <ComboBox x:Name="MinuteBox" Width="64" MinHeight="32" Style="{StaticResource DefaultComboBox}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 连弹次数 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="连弹次数" FontSize="13" Foreground="{StaticResource TextRegularBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBox x:Name="RepeatBurstBox" Width="200" MinHeight="32" Text="1"
                                             HorizontalAlignment="Left" Style="{StaticResource DefaultTextBox}"/>
                                    <TextBlock Text="触发后共弹出 N 次；点 完成消耗 1 次，1 分钟后再弹下一次；点 稍后不消耗" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- 星期 -->
                            <Grid x:Name="WeekdayPanel" Margin="0,0,0,10" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="星期" FontSize="13" Foreground="{StaticResource TextRegularBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <WrapPanel Grid.Column="1">
                                    <CheckBox x:Name="ChkMon" Content="周一" Margin="0,0,10,4"/>
                                    <CheckBox x:Name="ChkTue" Content="周二" Margin="0,0,10,4"/>
                                    <CheckBox x:Name="ChkWed" Content="周三" Margin="0,0,10,4"/>
                                    <CheckBox x:Name="ChkThu" Content="周四" Margin="0,0,10,4"/>
                                    <CheckBox x:Name="ChkFri" Content="周五" Margin="0,0,10,4"/>
                                    <CheckBox x:Name="ChkSat" Content="周六" Margin="0,0,10,4"/>
                                    <CheckBox x:Name="ChkSun" Content="周日" Margin="0,0,0,4"/>
                                </WrapPanel>
                            </Grid>

                            <!-- 关联股票：代码 + 名称同一行 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关联股票" FontSize="13" Foreground="{StaticResource TextRegularBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" x:Name="StockCodeBox" MinHeight="32" MaxLength="6" Margin="0,0,8,0"
                                         Style="{StaticResource DefaultTextBox}"/>
                                <TextBox Grid.Column="2" x:Name="StockNameBox" MinHeight="32"
                                         Style="{StaticResource DefaultTextBox}"/>
                            </Grid>

                            <!-- 动作按钮（原版 el-checkbox-group：气泡提醒出现时显示的按钮） -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="动作按钮" FontSize="13" Foreground="{StaticResource TextRegularBrush}" VerticalAlignment="Top"
                                           HorizontalAlignment="Right" Margin="0,6,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="ChkDoneAction" Content="完成" IsChecked="True" Margin="0,0,16,0"/>
                                        <CheckBox x:Name="ChkSnoozeAction" Content="稍后提醒" IsChecked="True"/>
                                    </StackPanel>
                                    <TextBlock Text="气泡提醒出现时显示的按钮" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- 备注内�? -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="备注内容" FontSize="13" Foreground="{StaticResource TextRegularBrush}" VerticalAlignment="Top"
                                           HorizontalAlignment="Right" Margin="0,6,10,0"/>
                                <TextBox Grid.Column="1" x:Name="ContentBox" Height="72" TextWrapping="Wrap"
                                         AcceptsReturn="True" Style="{StaticResource DefaultTextBox}" MaxLength="200"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>