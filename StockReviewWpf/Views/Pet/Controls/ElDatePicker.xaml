<UserControl x:Class="StockReviewWpf.Views.Pet.Controls.ElDatePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StockReviewWpf.Views.Pet.Controls">
    <!-- 可复用 el-date-picker：点击日期框弹出 ElCalendar，选择日期后自动关闭 -->
    <!-- 解决原生 DatePicker 在 AllowsTransparency=True 透明窗口内下拉按钮失效问题 -->
    <Grid>
        <Border x:Name="DateBox" Background="White" BorderBrush="#DCDFE6" BorderThickness="1"
                CornerRadius="4" MinHeight="32" Cursor="Hand"
                PreviewMouseLeftButtonDown="DateBox_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="DateBox_PreviewMouseLeftButtonUp">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#909399"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <TextBlock x:Name="DateHint" FontSize="13" Foreground="#C0C4CC"
                               Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="DateText" FontSize="13" Foreground="#606266"
                               Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <!-- el 日历图标 -->
                <Path Grid.Column="1" Data="M 8 2 L 8 4 M 16 4 L 18 4 A 1 1 0 0 1 19 5 L 19 19 A 1 1 0 0 1 18 20 L 2 20 A 1 1 0 0 1 1 19 L 1 5 A 1 1 0 0 1 2 4 L 4 4 M 4 8 L 18 8 M 16 2 L 16 4 M 8 2 L 16 2"
                      Stroke="#909399" StrokeThickness="1.4" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- StaysOpen=False：外部任意点击由 WPF 原生关闭（跨窗口一致）。
             "打开瞬间的鼠标抬起被误判"的长按问题已通过改为"抬起时开弹层"规避（见 code-behind）。
             ESC/任意键盘按键关闭由 code-behind 的全局键盘钩子处理。
             严禁设置 PopupAnimation（Fade/Slide/Scroll）：动画期间 PopupRoot 带位移变换，
             命中测试坐标与视觉位置不一致，点日期/切月会点错格子（时好时坏）。
             淡入动效由 code-behind 对 PopupCard 做透明度动画替代，不影响命中测试。 -->
        <Popup x:Name="DatePopup" IsOpen="False" Placement="Bottom"
               PlacementTarget="{Binding ElementName=DateBox}"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
            <Border x:Name="PopupCard" Margin="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14"/>
                </Border.Effect>
                <controls:ElCalendar x:Name="Calendar"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
