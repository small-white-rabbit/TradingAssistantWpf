<Window x:Class="StockReviewWpf.Views.Pet.Dialogs.AddPlanDialog"
        xmlns:controls="clr-namespace:StockReviewWpf.Views.Pet.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加交易计划"
        Width="600"
        SizeToContent="Height"
        MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- ============ el-date-picker（Element Plus 风格日期选择�?�� ============ -->

        <!-- 日单元格�?8x28 圆�?，今天蓝字�?��?�中蓝底白字、相邻月�?��、�?用日期淡�?-->
        <Style TargetType="CalendarDayButton">
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextRegularBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPlaceholderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BorderBaseBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- �?月�?图单元格 -->
        <Style TargetType="CalendarButton">
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextRegularBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="HasSelectedDays" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日历面板头（�?2026�?8�?�?+ 星期行），�?�?el-date-picker__header -->
        <Style TargetType="CalendarItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <Grid x:Name="PART_Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Margin="4,4,4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton" Grid.Column="0" Width="24" Height="24"
                                        Focusable="False" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                <Path Data="M 10 3 L 5 8 L 10 13" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="PART_HeaderButton" Grid.Column="1" Focusable="False" Cursor="Hand"
                                        HorizontalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" CornerRadius="4" Padding="8,3">
                                                <ContentPresenter x:Name="headerText" TextElement.FontSize="13"
                                                                  TextElement.FontWeight="Bold" TextElement.Foreground="{StaticResource TextPrimaryBrush}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="headerText" Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="PART_NextButton" Grid.Column="2" Width="24" Height="24"
                                        Focusable="False" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                <Path Data="M 6 3 L 11 8 L 6 13" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- 月�?图（首�?为星期头�? 年�?�?-->
                            <Grid Grid.Row="1">
                                <UniformGrid x:Name="PART_MonthView" Columns="7" Rows="7" Margin="4,0"/>
                                <UniformGrid x:Name="PART_YearView" Columns="3" Rows="4" Visibility="Collapsed" Margin="6,8"/>
                            </Grid>

                            <Rectangle x:Name="PART_DisabledVisual" Fill="#A5FFFFFF" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType=Calendar}}" Value="Year">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType=Calendar}}" Value="Decade">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日历�?��：白底圆角卡�?-->
        <Style TargetType="Calendar">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="245"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Calendar">
                        <StackPanel>
                            <CalendarItem Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- el-input �?placeholder（Tag 为提示文字，空�?�时显示�?-->
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" FontSize="13" Foreground="{StaticResource TextPlaceholderBrush}"
                                           Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- el-radio（圆形指示器�?-->
        <Style x:Key="ElRadio" TargetType="RadioButton">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextRegularBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse x:Name="ring" Stroke="{StaticResource BorderBaseBrush}" StrokeThickness="1"/>
                                <Ellipse x:Name="dot" Width="6" Height="6" Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- el-radio-button（分段按�?��size=small；左�?px与相邻按�?��并分隔线�?-->
        <Style x:Key="ElRadioButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextRegularBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="-1,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource BorderBaseBrush}"
                                BorderThickness="1,0,1,0" Padding="10,3">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fluent �?���?px 圆�? + 柔和弥散阴影，标题位于表�?+ 发丝分隔�?-->
    <Border Background="{StaticResource BgPageBrush}" BorderBrush="{StaticResource BorderLightBrush}"
            BorderThickness="1" CornerRadius="8" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.16"/>
        </Border.Effect>
        <DockPanel>
            <!-- 标�?栏（�?���?�� -->
            <Border DockPanel.Dock="Top" CornerRadius="8,8,0,0" Padding="20,11,8,11"
                    BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="添加交易计划" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource CaptionCloseBtn}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <!-- 底部按钮：发丝线与表单分�?-->
            <Border DockPanel.Dock="Bottom" Padding="20,12" Background="{StaticResource BgPageBrush}"
                    BorderBrush="{StaticResource BorderLighterBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource DefaultButton}" Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button Content="保存计划" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsValid}" Click="ConfirmButton_Click"/>
                </StackPanel>
            </Border>

            <!-- 表单（el-form label-width=100px label-position=right�?-->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,16">
                <StackPanel>
                    <!-- 股票代码 -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="股票代码" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource PlaceholderTextBox}" Tag="例如: 600519"
                                 Text="{Binding StockCode, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- 股票名称 -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="股票名称" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource PlaceholderTextBox}" Tag="自动获取"
                                 Text="{Binding StockName, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- 计划类型 -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="计划类型" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="买入" GroupName="PlanType" Style="{StaticResource ElRadio}"
                                             IsChecked="{Binding PlanType, Converter={StaticResource TabCheckConverter}, ConverterParameter=buy}"/>
                                <RadioButton Content="卖出" GroupName="PlanType" Style="{StaticResource ElRadio}"
                                             IsChecked="{Binding PlanType, Converter={StaticResource TabCheckConverter}, ConverterParameter=sell}"/>
                                <RadioButton Content="数据收集" GroupName="PlanType" Style="{StaticResource ElRadio}"
                                             IsChecked="{Binding PlanType, Converter={StaticResource TabCheckConverter}, ConverterParameter=watch}"/>
                            </StackPanel>
                            <TextBlock Text="数据收集模式：持续采集分时数据与卖点信号用于回测优化参数/权重，除目标价、止损价提醒外，其它卖点提醒仅记录不弹气泡" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding PlanType, Converter={StaticResource StringEqualsToVis}, ConverterParameter=watch}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 计划日期 -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="计划日期" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <!-- el-date-picker：点击输入�?/图标弹出日历卡片（�?用今天之前） -->
                        <Grid Grid.Column="1">
                            <Border x:Name="DateBox" Background="White" BorderBrush="{StaticResource BorderBaseBrush}" BorderThickness="1"
                                    CornerRadius="4" Height="32" Cursor="Hand"
                                    PreviewMouseLeftButtonDown="DateBox_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="DateBox_PreviewMouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBlock x:Name="DateHint" Text="选择计划日期" FontSize="13" Foreground="{StaticResource TextPlaceholderBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <TextBlock x:Name="DateText" FontSize="13" Foreground="{StaticResource TextRegularBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    </Grid>
                                    <!-- el 日历图标 -->
                                    <Path Grid.Column="1" Data="M 8 2 L 8 4 M 16 4 L 18 4 A 1 1 0 0 1 19 5 L 19 19 A 1 1 0 0 1 18 20 L 2 20 A 1 1 0 0 1 1 19 L 1 5 A 1 1 0 0 1 2 4 L 4 4 M 4 8 L 18 8 M 16 2 L 16 4 M 8 2 L 16 2"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- StaysOpen=False：外部任意点击由 WPF 原生关闭；
                                 长按问题已通过"抬起时开弹层"规避（见 code-behind），ESC 由全局键盘钩子关闭 -->
                            <Popup x:Name="DatePopup" IsOpen="False" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=DateBox}"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Margin="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.14"/>
                                    </Border.Effect>
                                    <!-- �?��日历（系�?Calendar 在�?�明 Popup 内渲染异常） -->
                                    <controls:ElCalendar x:Name="PlanCalendar" DisablePast="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </Grid>

                    <!-- 进场理由：分类分段按�?�� -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="进场理由" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding EntryTypeGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- DockPanel：按需要 Fill 拿到真实剩余宽度，WrapPanel 才能正确换行
                                         （StackPanel 会给子项无限测量宽度，WrapPanel 不换行导致右侧被裁） -->
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name, StringFormat={}{0}：}"
                                                   FontWeight="Bold" Foreground="{StaticResource TextRegularBrush}"
                                                   FontSize="13" VerticalAlignment="Top" Margin="0,3,8,0"/>
                                        <Border BorderBrush="{StaticResource BorderBaseBrush}" BorderThickness="1" CornerRadius="4" Background="White"
                                                VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <ItemsControl ItemsSource="{Binding Children}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <!-- 换�?布局：子类�?时自动折行（原版 el-radio-group wrap�?-->
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <RadioButton GroupName="EntryReason" Style="{StaticResource ElRadioButton}"
                                                                     Content="{Binding Name}"
                                                                     Command="{Binding DataContext.SelectEntryReasonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                     CommandParameter="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- 进场价位 + 获取�?���?-->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="进场价位" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource PlaceholderTextBox}" Tag="输入代码后自动获取" Width="220"
                                     Text="{Binding EntryPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="获取中..." FontSize="12" Foreground="{StaticResource PrimaryBrush}" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding PriceLoading, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 离场价位分隔�?-->
                    <Grid Margin="0,0,0,18">
                        <Border Height="1" Background="{StaticResource BorderBaseBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="离场价位" Foreground="{StaticResource TextRegularBrush}" FontWeight="SemiBold" FontSize="13"
                                   Background="White" Padding="0,0,8,0" HorizontalAlignment="Left"/>
                    </Grid>

                    <!-- �?��价位 + �?��空间% -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="目标价位" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PlaceholderTextBox}" Tag="止盈目标价" Text="{Binding TargetPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TargetPctText}" FontSize="14" FontWeight="Bold"
                                       Foreground="{Binding TargetPctColor}" Margin="8,0,0,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding TargetPctText, Converter={StaticResource NotNullToVis}}"/>
                        </Grid>
                    </Grid>

                    <!-- 止损价位 + 止损空间% -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="止损价位" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource PlaceholderTextBox}" Tag="硬性止损价"
                                     Text="{Binding StopLossText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StopPctText}" FontSize="14" FontWeight="Bold"
                                       Foreground="{Binding StopPctColor}" Margin="8,0,0,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding StopPctText, Converter={StaticResource NotNullToVis}}"/>
                        </Grid>
                    </Grid>

                    <!-- �?大持仓天�?-->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最大持仓天数" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource PlaceholderTextBox}"
                                 Text="{Binding MaxHoldDays, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- 备注 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="备注" Style="{StaticResource Label}" TextAlignment="Right" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource PlaceholderTextBox}" Tag="选填"
                                 Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- 校验错�?（原�?validation-error�?-->
                    <Border Background="{StaticResource DangerLightBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="12,8" Margin="0,0,0,4"
                            Visibility="{Binding ValidationError, Converter={StaticResource NotNullToVis}}">
                        <TextBlock FontSize="13" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="🚫 "/><Run Text="{Binding ValidationError, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
