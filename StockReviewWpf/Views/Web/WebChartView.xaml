<UserControl x:Class='StockReviewWpf.Views.Web.WebChartView'
             xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation'
             xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml'
             xmlns:wv2='clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf'
             Loaded='OnLoaded' Unloaded='OnUnloaded'>
    <Grid x:Name='RootGrid'>
        <wv2:WebView2 x:Name='WebView'
                      DefaultBackgroundColor='#F5F7FA'/>
        <!-- 加载失败兜底：错误提示 + 重试按钮（导航失败/浏览器进程崩溃时显示） -->
        <Border x:Name='ErrorOverlay' Background='#F5F7FA' Visibility='Collapsed'>
            <StackPanel HorizontalAlignment='Center' VerticalAlignment='Center' MaxWidth='420'>
                <TextBlock x:Name='ErrorText'
                           Text='页面加载失败'
                           FontSize='14' Foreground='#606266'
                           TextWrapping='Wrap' HorizontalAlignment='Center'/>
                <Button x:Name='RetryButton' Content='重试'
                        Margin='0,16,0,0' Padding='20,6'
                        HorizontalAlignment='Center'
                        Click='RetryButton_Click'/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
