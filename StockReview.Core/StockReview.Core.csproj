<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StockReview.Core</RootNamespace>
    <AssemblyName>StockReview.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite + Dapper（文档推荐：手写 SQL 风格延续，data.db 零改动） -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="Dapper" Version="2.1.35" />

    <!-- 富途 C# SDK（文档推荐：直连 FutuOpenD，去 Python 依赖） -->
    <PackageReference Include="futu-api" Version="10.10.7008" />

    <!-- 日志（Core 只发日志；sink 配置在 WPF 启动项目，由其自行引用 Sinks 包） -->
    <PackageReference Include="Serilog" Version="4.2.0" />

    <!-- 后台服务宿主 -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />

    <!-- JSON -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

    <!-- GDI+ 图像处理（截图压缩，Windows 专用） -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>
